---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Carrusel from '../components/Carrusel.astro';
import TarjetaMoto from '../components/TarjetaMoto.astro';
import Formulario from '../components/Formulario.astro';
import Financiacion from '../components/Financiacion.astro';
import Ventajas from '../components/Ventajas.astro';
import { MARCAS, EMPRESA } from '../data/sitio';
import { imgSitio } from '../lib/imagenes';

const motos = await getCollection('motos');
const destacadas = motos.filter((m) => m.data.destacada).sort((a, b) => MARCAS.findIndex((x) => x.slug === a.data.marca) - MARCAS.findIndex((x) => x.slug === b.data.marca) || a.data.orden - b.data.orden);
const contar = (marca: string) => motos.filter((m) => m.data.marca === marca).length;
const tel = EMPRESA.telefono.replace(/\s/g, '');

const diapos = [
  { img: 'hero-675nk-hormigon', titulo: 'CFMOTO 675NK', url: '/cfmoto/motos/675nk/', pos: '50% 60%' },
  { img: 'hero-utv-dunas', titulo: 'Buggies y UTV CFMOTO', url: '/cfmoto/buggies/', pos: '60% 50%' },
  { img: 'hero-caballero-ruta', titulo: 'Fantic Caballero', url: '/fantic/caballero/' },
  { img: 'hero-beta', titulo: 'Beta enduro', url: '/beta/enduro/' },
  { img: 'hero-mitt', titulo: 'MITT', url: '/mitt/' },
];
const franjas: Record<string, string> = { fantic: 'franja-fantic', beta: 'franja-beta', cfmoto: 'hero-675nk-hormigon', mitt: 'franja-mitt' };
const servicios = [
  { img: 'servicio-alquiler', titulo: 'Motos de alquiler', texto: 'Alquiler de motos en Barbate. Consúltanos los modelos y las fechas disponibles.' },
  { img: 'servicio-boutique', titulo: 'Tienda boutique', texto: 'Cascos, equipación y accesorios de marcas como LS2, Airoh, Alpinestars o Shad.' },
  { img: 'servicio-segunda-mano', titulo: 'Segunda mano', texto: 'Motos de ocasión revisadas. Pregúntanos qué unidades tenemos disponibles.' },
];
const accesorios = ['acc-ls2', 'acc-airoh', 'acc-alpinestars', 'acc-shad', 'acc-sp-connect', 'acc-liqui-moli', 'acc-komobi'];
const nombresAcc: Record<string, string> = { 'acc-ls2': 'LS2', 'acc-airoh': 'Airoh', 'acc-alpinestars': 'Alpinestars', 'acc-shad': 'Shad', 'acc-sp-connect': 'SP Connect', 'acc-liqui-moli': 'Liqui Moly', 'acc-komobi': 'Komobi' };
---
<Base
  titulo="Motodest | Concesionario oficial Fantic, Beta, CFMOTO y MITT en Barbate"
  descripcion="Concesionario oficial de motos en Barbate (Cádiz): Fantic, Beta, CFMOTO y MITT. Motos, quads y buggies nuevos con financiación, alquiler, segunda mano y boutique."
  imagen={imgSitio('hero-675nk-hormigon')}
  superpuesta
>
  <Fragment slot="hero">
    <Carrusel diapos={diapos} antetitulo="Barbate · Cádiz" h1="Concesionario oficial de motos en Barbate" texto="Fantic, Beta, CFMOTO y MITT: motos, quads y buggies nuevos con asesoramiento cercano y financiación a tu medida." />
    <Ventajas />
  </Fragment>

  <section class="seccion" id="destacadas">
    <div class="contenedor">
      <h2 class="tit-seccion">Motos destacadas</h2>
      <div class="rejilla rejilla--motos">
        {destacadas.map((m) => <TarjetaMoto moto={m} />)}
      </div>
      <div class="cta-linea cta-linea--centro">
        <a class="btn" href="#contacto">Pide información</a>
        <span>o llámanos al <a class="tel" href={`tel:${tel}`}>{EMPRESA.telefonoVisible}</a></span>
      </div>
    </div>
  </section>

  <section class="seccion seccion--gris">
    <div class="contenedor">
      <h2 class="tit-seccion">Concesionario oficial</h2>
      <div class="marcas">
        {MARCAS.map((m) => (
          <a class="marca" href={`/${m.slug}/`}>
            <span class="marca__foto">
              <Image format="avif" src={imgSitio(franjas[m.slug])} alt={`Motos ${m.nombre} en Motodest`} widths={[400, 640]} sizes="(max-width: 700px) 92vw, 25vw" class="marca__img" />
              <span class="marca__nombre">{m.nombre}</span>
            </span>
            <span class="marca__txt">
              <span>{contar(m.slug)} modelos · {m.categorias.map((c) => c.nombre).join(', ')}</span>
              <span class="marca__ver">Descubre los modelos →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion--azul deco" id="financiacion">
    <div class="contenedor">
      <h2 class="tit-seccion">Financiación a tu medida</h2>
      <p class="intro intro--centro">Calcula cuánto te sale al mes. Elige si das entrada y el plazo, y te preparamos la financiación sin compromiso.</p>
      <Financiacion id="calc-home" />
    </div>
  </section>

  <section class="seccion" id="servicios">
    <div class="contenedor">
      <h2 class="tit-seccion">Nuestros servicios</h2>
      <div class="servicios">
        {servicios.map((s) => (
          <article class="servicio">
            <Image format="avif" src={imgSitio(s.img)} alt={s.titulo} widths={[480, 720]} sizes="(max-width: 700px) 92vw, 30vw" class="servicio__img" />
            <div class="servicio__txt">
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
              <a class="servicio__ver" href="#contacto">Pregúntanos →</a>
            </div>
          </article>
        ))}
      </div>
      <div class="cta-linea cta-linea--centro">
        <a class="btn" href="#contacto">Pide información</a>
        <span>o llámanos al <a class="tel" href={`tel:${tel}`}>{EMPRESA.telefonoVisible}</a></span>
      </div>
    </div>
  </section>

  <section class="marcas-acc">
    <h2 class="tit-seccion marcas-acc__tit">Nuestras marcas</h2>
    <p class="marcas-acc__txt">Cascos, equipación y accesorios de las marcas que usamos y recomendamos.</p>
    <div class="cinta" data-cinta>
      <ul class="cinta__pista">
        {[0, 1].map((rep) => accesorios.map((a) => (
          <li aria-hidden={rep ? 'true' : undefined}>
            <Image format="avif" src={imgSitio(a)} alt={rep ? '' : nombresAcc[a]} widths={[280, 420]} sizes="(max-width: 700px) 46vw, 20vw" />
            <span>{nombresAcc[a]}</span>
          </li>
        )))}
      </ul>
    </div>
    <div class="cta-linea cta-linea--centro">
      <a class="btn" href="#contacto">Pregunta por equipación</a>
      <span>o llámanos al <a class="tel" href={`tel:${tel}`}>{EMPRESA.telefonoVisible}</a></span>
    </div>
  </section>

  <Formulario titulo="¿Necesitas que te asesoremos?" subtitulo="Cuéntanos qué buscas y te llamamos" />
</Base>

<style>
  .cta-linea--centro { justify-content: center; }
  .intro--centro { text-align: center; margin: -10px auto max(24px, 2.4vw); }
  .marcas { display: grid; grid-template-columns: repeat(4, 1fr); gap: max(14px, 1.4vw); }
  .marca { display: flex; flex-direction: column; background: #fff; text-decoration: none; transition: box-shadow 0.2s, transform 0.2s; }
  .marca:hover { box-shadow: 0 18px 40px rgb(11 1 62 / 0.14); transform: translateY(-3px); }
  .marca__foto { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .marca__foto :global(.marca__img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .marca:hover :global(.marca__img) { transform: scale(1.05); }
  .marca__foto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 0.6), transparent 45%); }
  .marca__nombre { position: absolute; z-index: 1; left: 18px; bottom: 12px; color: #fff; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; font-size: clamp(1.1rem, 1.5vw, 1.5rem); }
  .marca__txt { display: grid; gap: 8px; padding: 14px 18px 18px; color: var(--gris); font-size: var(--fs-peq); }
  .marca__ver, .servicio__ver { color: var(--naranja); font-weight: 700; text-decoration: none; }
  .seccion--azul .intro--centro { color: #cfcce3; }
  .servicios { display: grid; grid-template-columns: repeat(3, 1fr); gap: max(14px, 1.4vw); }
  .servicio { border: 1px solid var(--borde); display: flex; flex-direction: column; }
  .servicio :global(.servicio__img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .servicio__txt { padding: 16px 20px 22px; }
  .servicio__txt h3 { font-size: var(--fs-h3); margin-bottom: 6px; }
  .servicio__txt p { color: var(--gris); font-size: var(--fs-peq); }
  .marcas-acc { background: #000; color: #fff; padding-block: max(56px, 6vw); overflow: hidden; }
  .marcas-acc__txt { text-align: center; color: #bbb; margin: -8px auto max(28px, 3vw); padding-inline: 4vw; }
  .marcas-acc .tel { color: #fff; }
  .cinta { overflow: hidden; }
  .cinta__pista { list-style: none; margin: 0; padding: 0; display: flex; gap: max(10px, 1vw); width: max-content; }
  .cinta__pista li { position: relative; width: clamp(200px, 21vw, 340px); aspect-ratio: 3 / 4; overflow: hidden; flex: none; }
  .cinta__pista :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.75); transition: filter 0.4s, transform 0.6s; }
  .cinta__pista li:hover :global(img) { filter: none; transform: scale(1.06); }
  .cinta__pista li span { position: absolute; left: 0; right: 0; bottom: 0; padding: 30px 14px 12px; background: linear-gradient(0deg, rgb(0 0 0 / 0.75), transparent); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0; transform: translateY(10px); transition: 0.35s; }
  .cinta__pista li:hover span { opacity: 1; transform: none; color: var(--naranja); }
  @media (max-width: 900px) { .marcas { grid-template-columns: 1fr 1fr; } .servicios { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .marcas { grid-template-columns: 1fr; } }
</style>
