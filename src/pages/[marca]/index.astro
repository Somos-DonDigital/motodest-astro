---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Carrusel from '../../components/Carrusel.astro';
import TarjetaMoto from '../../components/TarjetaMoto.astro';
import Formulario from '../../components/Formulario.astro';
import { MARCAS, EMPRESA, type Marca } from '../../data/sitio';
import { imgSitio, imgMoto } from '../../lib/imagenes';
import { euros } from '../../lib/formato';

export function getStaticPaths() {
  return MARCAS.map((m) => ({ params: { marca: m.slug }, props: { marca: m } }));
}
const { marca } = Astro.props as { marca: Marca };
const motos = (await getCollection('motos', (m) => m.data.marca === marca.slug)).sort((a, b) => a.data.orden - b.data.orden);
const contar = (c: string) => motos.filter((m) => m.data.categoria === c).length;
const destacadas = [...motos.filter((m) => m.data.destacada), ...marca.categorias.map((c) => motos.find((m) => m.data.categoria === c.slug && !m.data.destacada)!)].filter(Boolean).slice(0, 4);
const tel = EMPRESA.telefono.replace(/\s/g, '');

const DIAPOS: Record<string, { img: string; titulo: string; url: string; pos?: string }[]> = {
  fantic: [
    { img: 'hero-caballero-ruta', titulo: 'Fantic Caballero', url: '/fantic/caballero/' },
    { img: 'hero-fantic', titulo: 'Fantic enduro', url: '/fantic/enduro/' },
    { img: 'detalle-motor-700', titulo: 'Caballero 700', url: '/fantic/caballero/' },
  ],
  beta: [{ img: 'hero-beta', titulo: 'Beta enduro', url: '/beta/enduro/' }],
  cfmoto: [
    { img: 'hero-675nk-hormigon', titulo: 'CFMOTO 675NK', url: '/cfmoto/motos/675nk/', pos: '50% 60%' },
    { img: 'hero-utv-dunas', titulo: 'Buggies y UTV CFMOTO', url: '/cfmoto/buggies/' },
    { img: 'hero-cfmoto', titulo: 'Quads CFMOTO', url: '/cfmoto/atv/' },
  ],
  mitt: [{ img: 'hero-mitt', titulo: 'MITT', url: '/mitt/scooters/' }],
};
const gamas = marca.categorias.map((c) => {
  const lista = motos.filter((m) => m.data.categoria === c.slug);
  const rep = lista.find((m) => m.data.destacada && m.data.imagenes.length) ?? lista.find((m) => m.data.imagenes.length);
  const precios = lista.map((m) => m.data.precio).filter((p): p is number => p != null);
  return { cat: c, n: lista.length, img: rep?.data.imagenes[0]?.src, desde: precios.length ? Math.min(...precios) : null, palabra: c.nombre.split(/[\s/]+/)[0].toUpperCase() };
});
const historiaImg = marca.slug === 'fantic' ? 'historia-fantic-2' : marca.historiaImg;
---
<Base
  titulo={`${marca.h1} | Motodest Barbate`}
  descripcion={`${marca.h1}: ${marca.lema} Precios, fichas técnicas oficiales y financiación en Motodest.`}
  imagen={imgSitio(marca.hero)}
  superpuesta
  migas={[{ nombre: marca.nombre, url: `/${marca.slug}/` }]}
  schema={[{
    '@context': 'https://schema.org', '@type': 'ItemList', name: `Gama ${marca.nombre} en Motodest`,
    itemListElement: marca.categorias.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.h1, url: new URL(`/${marca.slug}/${c.slug}/`, Astro.site).toString() })),
  }]}
>
  <Carrusel slot="hero" diapos={DIAPOS[marca.slug]} antetitulo="Concesionario oficial" h1={marca.h1} texto={marca.lema} cta={{ texto: "Ver la gama", url: "#gama" }} alto="medio" />

  <section class="historia">
    <Image format="avif" src={imgSitio(historiaImg)} alt={marca.nombre} widths={[960, 1600, 2400]} sizes="100vw" class="historia__img" />
    <span class="historia__dato" aria-hidden="true">{marca.historiaDato.grande}</span>
    <div class="historia__in contenedor">
      <div class="historia__txt">
        <span class="antetitulo">{marca.historiaDato.texto}</span>
        <h2 class="tit-seccion">{marca.historiaTitulo}</h2>
        {marca.historia.map((p) => <p>{p}</p>)}
        <p>En Motodest somos concesionario oficial {marca.nombre} en Barbate: te asesoramos, preparamos tu moto y te acompañamos en el mantenimiento.</p>
        <div class="cta-linea">
          <a class="btn historia__cta" href="#gama">Descubre la gama {marca.nombre}
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 4v15m-6-6 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="gama seccion" id="gama">
    <div class="contenedor">
      <h2 class="tit-seccion">La gama {marca.nombre}</h2>
      <div class="gama__rejilla">
        {gamas.map((g) => (
          <a class="gcat" href={`/${marca.slug}/${g.cat.slug}/`} style={`--n:${g.palabra.length}`}>
            <span class="gcat__palabra" aria-hidden="true">{g.palabra}</span>
            {g.img && <Image format="avif" fit="contain" src={imgMoto(g.img)} alt={`${marca.nombre} ${g.cat.nombre}`} widths={[360, 560, 760]} sizes="(max-width: 700px) 88vw, (max-width: 1100px) 44vw, 30vw" class="gcat__moto" />}
            <span class="gcat__pie">
              <strong>{g.cat.nombre}</strong>
              <span>{g.n} modelos{g.desde ? ` · desde ${euros(g.desde)}` : ''}</span>
              <span class="gcat__ver" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <h2 class="tit-seccion">{marca.nombre} destacadas</h2>
      <div class="rejilla rejilla--motos">
        {destacadas.map((m) => <TarjetaMoto moto={m} />)}
      </div>
    </div>
  </section>

  <Formulario titulo="¿Necesitas que te asesoremos?" subtitulo={`${marca.nombre}: te contamos todo lo que necesitas saber`} />
</Base>
<style>
  .historia { position: relative; isolation: isolate; overflow: hidden; color: #fff; background: var(--azul); min-height: clamp(560px, 48vw, 820px); display: flex; align-items: center; }
  .historia :global(.historia__img) { position: absolute; inset: 0; z-index: -3; width: 100%; height: 115%; max-width: none; object-fit: cover; object-position: 70% 50%; }
  .historia::before { content: ''; position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, rgb(11 1 62 / 0.96) 0%, rgb(11 1 62 / 0.88) 34%, rgb(11 1 62 / 0.35) 62%, rgb(11 1 62 / 0) 82%), linear-gradient(0deg, rgb(11 1 62 / 0.55), transparent 35%); }
  .historia::after { content: ''; position: absolute; right: 0; bottom: 0; z-index: -1; width: clamp(220px, 30vw, 520px); height: clamp(160px, 22vw, 380px); background: url('/deco-lineas.svg') no-repeat right bottom / contain; opacity: 0.9; }
  .historia__dato { position: absolute; z-index: -1; left: max(4vw, calc((100vw - var(--ancho)) / 2 - 1vw)); bottom: -0.12em; font-family: 'Cairo', sans-serif; font-weight: 900; font-size: clamp(9rem, 22vw, 26rem); line-height: 0.8; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 2px rgb(244 123 41 / 0.35); user-select: none; pointer-events: none; }
  .historia__in { position: relative; padding-block: max(56px, 6vw); }
  .historia__txt { max-width: 560px; }
  .historia .antetitulo { color: var(--naranja); }
  .historia .tit-seccion { color: #fff; margin: 6px 0 max(18px, 1.6vw); text-align: left; }
  .historia p { color: #e6e4f2; font-size: clamp(1rem, 1.1vw, 1.12rem); line-height: 1.65; max-width: 52ch; }
  .historia .cta-linea { margin-top: max(20px, 1.8vw); }
  .historia .tel { color: #fff; }
  .historia__cta { display: inline-flex; align-items: center; gap: 10px; }
  .historia__cta svg { transition: transform 0.3s; }
  .historia__cta:hover svg { transform: translateY(4px); }
  @media (max-width: 860px) {
    .historia { min-height: 0; align-items: flex-end; }
    .historia :global(.historia__img) { height: 100%; object-position: 60% 50%; }
    .historia::before { background: linear-gradient(0deg, rgb(11 1 62 / 0.97) 0%, rgb(11 1 62 / 0.9) 55%, rgb(11 1 62 / 0.25) 100%); }
    .historia__in { padding-top: 46vw; }
    .historia__dato { top: 6vw; bottom: auto; font-size: 34vw; }
  }
  .gama__rejilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: max(14px, 1.4vw); }
  .gcat { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: clamp(300px, 28vw, 440px); padding: max(16px, 1.6vw); background: var(--gris-claro); overflow: hidden; text-decoration: none; color: var(--azul); isolation: isolate; container-type: inline-size; transition: background 0.35s; }
  .gcat__palabra { position: absolute; z-index: -1; left: 0.04em; top: 0.02em; font-weight: 900; text-transform: uppercase; line-height: 0.9; letter-spacing: -0.03em; font-size: min(calc(100cqi / (var(--n) * 0.6)), 34cqi); color: rgb(11 1 62 / 0.07); transition: color 0.35s, transform 0.5s; }
  .gcat :global(.gcat__moto) { position: absolute; left: 6%; right: 6%; top: 16%; bottom: 22%; width: 88%; height: 62%; object-fit: contain; transition: transform 0.5s cubic-bezier(.2,.8,.2,1); }
  .gcat__pie { position: relative; display: grid; grid-template-columns: 1fr auto; align-items: end; column-gap: 12px; border-top: 2px solid var(--azul); padding-top: 10px; }
  .gcat__pie strong { font-size: clamp(1.2rem, 1.8vw, 1.8rem); font-weight: 800; text-transform: uppercase; line-height: 1.1; }
  .gcat__pie span { grid-column: 1; font-size: var(--fs-peq); color: var(--gris); }
  .gcat__pie .gcat__ver { grid-column: 2; grid-row: 1 / span 2; align-self: center; font-size: 1.8rem; color: var(--naranja); transition: transform 0.3s; }
  .gcat:hover { background: var(--azul); color: #fff; }
  .gcat:hover .gcat__palabra { color: rgb(244 123 41 / 0.22); transform: translateX(3%); }
  .gcat:hover :global(.gcat__moto) { transform: translateX(4%) scale(1.06); }
  .gcat:hover .gcat__pie { border-color: var(--naranja); }
  .gcat:hover .gcat__pie span { color: #cfcce3; }
  .gcat:hover .gcat__ver { transform: translateX(6px); }
  @media (max-width: 560px) { .gama__rejilla { grid-template-columns: 1fr; } }
  @media (max-width: 860px) {
    .historia { grid-template-columns: 1fr; }
    .historia__txt { padding-inline: 4vw; }
    .historia__txt::after { right: 4vw; bottom: 10px; }
    .historia :global(.historia__img) { aspect-ratio: 16 / 10; }
    .gama__rejilla { grid-template-columns: repeat(2, 1fr); }
  }
</style>
