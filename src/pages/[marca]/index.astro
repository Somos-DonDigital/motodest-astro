---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Carrusel from '../../components/Carrusel.astro';
import TarjetaMoto from '../../components/TarjetaMoto.astro';
import Formulario from '../../components/Formulario.astro';
import { MARCAS, EMPRESA, type Marca } from '../../data/sitio';
import { imgSitio } from '../../lib/imagenes';

export function getStaticPaths() {
  return MARCAS.map((m) => ({ params: { marca: m.slug }, props: { marca: m } }));
}
const { marca } = Astro.props as { marca: Marca };
const motos = (await getCollection('motos', (m) => m.data.marca === marca.slug)).sort((a, b) => a.data.orden - b.data.orden);
const contar = (c: string) => motos.filter((m) => m.data.categoria === c).length;
const destacadas = [...motos.filter((m) => m.data.destacada), ...marca.categorias.map((c) => motos.find((m) => m.data.categoria === c.slug && !m.data.destacada)!)].filter(Boolean).slice(0, 4);
const tel = EMPRESA.telefono.replace(/\s/g, '');

const DIAPOS: Record<string, { img: string; titulo: string; url: string; pos?: string }[]> = {
  fantic: [
    { img: 'hero-caballero-ruta', titulo: 'Fantic Caballero', url: '/fantic/caballero/' },
    { img: 'hero-fantic', titulo: 'Fantic enduro', url: '/fantic/enduro/' },
    { img: 'detalle-motor-700', titulo: 'Caballero 700', url: '/fantic/caballero/' },
  ],
  beta: [{ img: 'hero-beta', titulo: 'Beta enduro', url: '/beta/enduro/' }],
  cfmoto: [
    { img: 'hero-675nk-hormigon', titulo: 'CFMOTO 675NK', url: '/cfmoto/motos/675nk/', pos: '50% 60%' },
    { img: 'hero-utv-dunas', titulo: 'Buggies y UTV CFMOTO', url: '/cfmoto/buggies/' },
    { img: 'hero-cfmoto', titulo: 'Quads CFMOTO', url: '/cfmoto/atv/' },
  ],
  mitt: [{ img: 'hero-mitt', titulo: 'MITT', url: '/mitt/scooters/' }],
};
const historiaImg = marca.slug === 'fantic' ? 'historia-fantic-2' : marca.historiaImg;
---
<Base
  titulo={`${marca.h1} | Motodest Barbate`}
  descripcion={`${marca.h1}: ${marca.lema} Precios, fichas técnicas oficiales y financiación en Motodest.`}
  imagen={imgSitio(marca.hero)}
  superpuesta
  migas={[{ nombre: marca.nombre, url: `/${marca.slug}/` }]}
  schema={[{
    '@context': 'https://schema.org', '@type': 'ItemList', name: `Gama ${marca.nombre} en Motodest`,
    itemListElement: marca.categorias.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.h1, url: new URL(`/${marca.slug}/${c.slug}/`, Astro.site).toString() })),
  }]}
>
  <Carrusel slot="hero" diapos={DIAPOS[marca.slug]} h1={marca.h1} alto="medio" />

  <section class="historia">
    <div class="historia__txt">
      <h2>{marca.historiaTitulo}</h2>
      {marca.historia.map((p) => <p>{p}</p>)}
      <p>En Motodest somos concesionario oficial {marca.nombre} en Barbate: te asesoramos, preparamos tu moto y te acompañamos en el mantenimiento.</p>
      <div class="cta-linea">
        <a class="btn" href="#contacto">Pide información</a>
        <span>o llámanos al <a class="tel" href={`tel:${tel}`}>{EMPRESA.telefonoVisible}</a></span>
      </div>
    </div>
    <Image src={imgSitio(historiaImg)} alt={marca.nombre} widths={[640, 960, 1400]} sizes="(max-width: 860px) 100vw, 63vw" class="historia__img" />
  </section>

  <section class="gama" id="gama">
    <h2 class="tit-seccion">La gama {marca.nombre}</h2>
    <div class="gama__franjas" style={`--n:${marca.categorias.length}`}>
      {marca.categorias.map((c) => (
        <a class="gama__item" href={`/${marca.slug}/${c.slug}/`}>
          <Image src={imgSitio(c.imagen)} alt={c.h1} widths={[300, 480, 720]} sizes="(max-width: 700px) 50vw, 20vw" class="gama__img" />
          <span class="gama__txt"><strong>{c.nombre}</strong><small>{contar(c.slug)} modelos</small></span>
        </a>
      ))}
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <h2 class="tit-seccion">{marca.nombre} destacadas</h2>
      <div class="rejilla rejilla--motos">
        {destacadas.map((m) => <TarjetaMoto moto={m} />)}
      </div>
    </div>
  </section>

  <Formulario titulo="¿Necesitas que te asesoremos?" subtitulo={`${marca.nombre}: te contamos todo lo que necesitas saber`} />
</Base>
<style>
  .historia { display: grid; grid-template-columns: 37fr 63fr; background: #000; color: #fff; min-height: clamp(360px, 42vw, 620px); }
  .historia__txt { position: relative; padding: max(32px, 3vw) max(24px, 3vw) max(80px, 7vw) max(4vw, calc((100vw - var(--ancho)) / 2)); }
  .historia__txt::after { content: ''; position: absolute; right: -6vw; bottom: max(24px, 3vw); width: clamp(160px, 18vw, 300px); height: 34px; background: url('/trazo-naranja.svg') no-repeat center / 100% 100%; z-index: 2; }
  .historia h2 { font-family: var(--fuente-texto); font-weight: 700; font-size: clamp(1.3rem, 1.8vw, 1.8rem); }
  .historia p { font-size: var(--fs-peq); color: #ddd; }
  .historia .tel { color: #fff; }
  .historia :global(.historia__img) { width: 100%; height: 100%; object-fit: cover; }
  .gama { padding-top: var(--esp-seccion); }
  .gama__franjas { display: grid; grid-template-columns: repeat(var(--n), 1fr); }
  .gama__item { position: relative; display: block; overflow: hidden; color: #fff; text-decoration: none; aspect-ratio: 1 / 2.1; max-height: 720px; width: 100%; }
  .gama__item :global(.gama__img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .gama__item:hover :global(.gama__img) { transform: scale(1.05); }
  .gama__item::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 0.6), transparent 35%); }
  .gama__txt { position: absolute; z-index: 1; left: 0; right: 0; bottom: max(14px, 1.4vw); display: grid; text-align: center; }
  .gama__txt strong { text-transform: uppercase; letter-spacing: 0.06em; font-size: clamp(0.95rem, 1.2vw, 1.2rem); }
  .gama__txt small { font-size: 0.78rem; opacity: 0.9; }
  .gama__item:hover strong { color: var(--naranja); }
  @media (max-width: 860px) {
    .historia { grid-template-columns: 1fr; }
    .historia__txt { padding-inline: 4vw; }
    .historia__txt::after { right: 4vw; bottom: 10px; }
    .historia :global(.historia__img) { aspect-ratio: 16 / 10; }
    .gama__franjas { grid-template-columns: repeat(2, 1fr); }
    .gama__item { aspect-ratio: 3 / 4; }
  }
</style>
