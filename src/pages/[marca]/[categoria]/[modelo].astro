---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TarjetaMoto from '../../../components/TarjetaMoto.astro';
import Formulario from '../../../components/Formulario.astro';
import Financiacion from '../../../components/Financiacion.astro';
import Icono from '../../../components/Icono.astro';
import GaleriaFotos from '../../../components/GaleriaFotos.astro';
import { marcaPorSlug, categoriaDe, EMPRESA, FINANCIACION } from '../../../data/sitio';
import { imgMoto, imgGaleria } from '../../../lib/imagenes';
import { cuotaMensual, capitalFinanciado } from '../../../lib/cuota';
import { ETIQUETAS, precioTexto, nombreCompleto, descripcionMoto, urlMoto, tipoMoto, type Moto } from '../../../lib/formato';

export async function getStaticPaths() {
  const motos = await getCollection('motos');
  return motos.map((m) => ({ params: { marca: m.data.marca, categoria: m.data.categoria, modelo: m.data.slug }, props: { moto: m } }));
}
const { moto } = Astro.props as { moto: Moto };
const m = moto.data;
const marca = marcaPorSlug(m.marca);
const cat = categoriaDe(m.marca, m.categoria);
const nombre = nombreCompleto(m);
const descripcion = descripcionMoto(m);
const filas = ETIQUETAS.filter(([k]) => m.ficha[k]).map(([k, et]) => [k, et, m.ficha[k]]);
const CLAVE = ['motor', 'cilindrada', 'potencia', 'par', 'alturaAsiento', 'peso', 'deposito', 'autonomia', 'bateria', 'traccion'];
const destacados = CLAVE.filter((k) => m.ficha[k]).slice(0, 6).map((k) => [k, ETIQUETAS.find(([x]) => x === k)![1], m.ficha[k]]);
const relacionadas = (await getCollection('motos', (x) => x.data.marca === m.marca && x.data.categoria === m.categoria && x.data.slug !== m.slug))
  .sort((a, b) => Math.abs(a.data.orden - m.orden) - Math.abs(b.data.orden - m.orden)).slice(0, 4);
const tel = EMPRESA.telefono.replace(/\s/g, '');
const wa = `https://wa.me/${EMPRESA.whatsapp}?text=${encodeURIComponent(`Hola, me interesa la ${nombre}.`)}`;
const imgs = m.imagenes.map((i) => imgMoto(i.src));
const variantes = m.imagenes.map((i) => i.color);
const fotos = (m.galeria ?? []).map((r) => imgGaleria(r));
// Cuota más baja posible (plazo máximo, sin entrada). Solo se enseña con las condiciones de la financiera confirmadas.
const cuotaDesde = m.precio == null ? null
  : cuotaMensual(capitalFinanciado(m.precio, 0, FINANCIACION.comisionApertura), FINANCIACION.tin, Math.max(...FINANCIACION.plazos));
const cuotaTxt = cuotaDesde?.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const miniatura = imgs[0];
// Distintivo ambiental DGT: solo cuando la moto se matricula y cumple Euro 5 (etiqueta C).
// Se da por hecho en las gamas de calle (MITT, CFMOTO motos); en el resto, solo si la ficha lo dice.
const CALLE = ['fantic/caballero', 'fantic/stealth', 'mitt/scooters', 'mitt/sport-touring', 'mitt/adventure', 'mitt/garage', 'cfmoto/motos'];
const textoNorma = `${m.ficha.homologacion ?? ''} ${m.ficha.motor ?? ''}`;
const etiquetaC = !/T3|tractor/i.test(textoNorma) && !/el[eé]ctric/i.test(m.ficha.motor ?? '') && (/Euro\s?5/i.test(textoNorma) || CALLE.includes(`${m.marca}/${m.categoria}`));
const imgsSchema = await Promise.all(imgs.map(async (i) => new URL((await getImage({ src: i, width: 1200, format: 'jpg' })).src, Astro.site).toString()));

const producto: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: nombre,
  brand: { '@type': 'Brand', name: marca.nombre },
  category: tipoMoto(m),
  description: descripcion,
  url: new URL(urlMoto(m), Astro.site).toString(),
  ...(imgsSchema.length ? { image: imgsSchema } : {}),
  ...(variantes.length > 1 ? { color: variantes.join(', ') } : {}),
  ...(m.precio != null
    ? { offers: { '@type': 'Offer', priceCurrency: 'EUR', price: m.precio, url: new URL(urlMoto(m), Astro.site).toString(), itemCondition: 'https://schema.org/NewCondition', seller: { '@id': `${Astro.site!.toString().replace(/\/$/, '')}/#negocio` } } }
    : {}),
};
---
<Base
  titulo={`${nombre}: precio y ficha técnica`}
  moto={nombre}
  descripcion={descripcion}
  imagen={imgs[0]}
  tipoOg="product"
  migas={[{ nombre: marca.nombre, url: `/${marca.slug}/` }, { nombre: cat.nombre, url: `/${marca.slug}/${cat.slug}/` }, { nombre: m.nombre, url: urlMoto(m) }]}
  schema={[producto]}
>
  <section class="ficha contenedor">
    <div class="galeria">
      <div class="galeria__principal" data-carrusel>
        {imgs.length
          ? imgs.map((src, i) => (
              <Image format="avif" fit="contain" src={src} alt={`${nombre}${imgs.length > 1 ? ` en color ${m.imagenes[i].color.toLowerCase()}` : ''}`} widths={[480, 800, 1200]} sizes="(max-width: 900px) 92vw, 55vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} class:list={['galeria__img', { activa: i === 0 }]} data-i={i} />
            ))
          : <div class="galeria__sin">Foto próximamente</div>}
        {fotos.map((f, i) => (
          <img class="galeria__slide" data-slide={i + 1} data-src={`${f.base}-900.avif`} data-srcset={`${f.base}-900.avif 900w, ${f.base}-1600.avif 1600w`} sizes="(max-width: 900px) 92vw, 55vw" alt={`${nombre}, foto ${i + 1}`} width={f.w} height={f.h} decoding="async" />
        ))}
        {fotos.length > 0 && (
          <>
            <button type="button" class="galeria__flecha galeria__flecha--ant" data-car-ant aria-label="Foto anterior"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4"/></svg></button>
            <button type="button" class="galeria__flecha galeria__flecha--sig" data-car-sig aria-label="Foto siguiente"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4"/></svg></button>
            <button type="button" class="galeria__ampliar" data-car-ampliar aria-label="Ver a pantalla completa"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
            <span class="galeria__cont"><b data-car-n>1</b> / {fotos.length + 1}</span>
          </>
        )}
      </div>
      {imgs.length > 1 && (
        <div class="galeria__colores">
          <p class="galeria__etq">Color: <strong class="galeria__nombre">{m.imagenes[0].color}</strong></p>
          <div class="galeria__minis" role="group" aria-label="Elegir color">
            {imgs.map((src, i) => (
              <button type="button" class:list={['galeria__mini', { activa: i === 0 }]} data-i={i} data-color={m.imagenes[i].color} aria-label={m.imagenes[i].color} aria-pressed={i === 0 ? 'true' : 'false'}>
                <Image format="avif" fit="contain" src={src} alt="" width={120} layout="fixed" />
                <span class="galeria__punto" style={`--c:${m.imagenes[i].hex}`}></span>
              </button>
            ))}
          </div>
        </div>
      )}
      {fotos.length > 0 && (
        <div class="galeria__fotos">
          <p class="galeria__etq">Fotos <button type="button" class="galeria__todas" data-abrir-foto="0">Ver las {fotos.length} a pantalla completa</button></p>
          <div class="galeria__tira">
            {fotos.map((f, i) => (
              <button type="button" class="galeria__foto" data-ir-slide={i + 1} aria-label={`Ver foto ${i + 1}`}>
                <img src={`${f.base}-400.avif`} alt="" width="160" height="106" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="resumen">
      <a class="resumen__marca" href={`/${marca.slug}/${cat.slug}/`}>{marca.nombre} · {cat.nombre}</a>
      <div class="resumen__cab">
        <h1>{nombre}</h1>
        {etiquetaC && (
          <span class="dgt" title="Distintivo ambiental C de la DGT" role="img" aria-label="Distintivo ambiental C de la DGT">
            <img src="/img/distintivo-c.png" alt="" width="56" height="56" />
          </span>
        )}
      </div>
      <p class="resumen__precio">{precioTexto(m)}</p>
      {m.precio != null && <p class="resumen__nota">Precio con la moto matriculada, IVA incluido. Consulta promociones y financiación.</p>}
      <p class="resumen__desc">{descripcion}</p>
      {m.precio != null && (
        <a class="resumen__cuota" href="#financiacion" data-cuota-minima>
          {cuotaDesde ? <>Elige tu cuota desde {cuotaTxt} €/mes*</> : 'Elige tu cuota con financiación inmediata'}
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.6"/></svg>
        </a>
      )}
      {cuotaDesde && <p class="resumen__legal">*Cuota orientativa sin entrada a {Math.max(...FINANCIACION.plazos)} meses, TIN {FINANCIACION.tin.toLocaleString('es-ES')} %, TAE {FINANCIACION.tae.toLocaleString('es-ES')} % aprox. Sujeta a estudio y aprobación de la entidad financiera.</p>}
      <div class="resumen__ctas" data-ctas>
        <a class="btn" href="#contacto">Me interesa</a>
        <a class="btn btn--borde" href={`tel:${tel}`}>Llámanos</a>
        <a class="btn btn--borde btn--wa" href={wa} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#25d366" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/><path fill="#fff" d="M17.3 14.4c-.3-.1-1.7-.8-1.9-.9-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1a7.6 7.6 0 0 1-3.8-3.3c-.3-.5.3-.5.8-1.6.1-.2 0-.4 0-.5l-.9-2c-.2-.5-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.3 3.3 0 0 0-1 2.5 5.8 5.8 0 0 0 1.2 3.1 13.3 13.3 0 0 0 5.1 4.5c1.9.8 2.6.9 3.6.7.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"/></svg>WhatsApp</a>
      </div>
      <p class="resumen__envio"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4.5l3.5 3.6V16h-8"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><span><strong>Envío a toda España</strong> Te la llevamos lista para rodar, estés donde estés.</span></p>
      <p class="resumen__tel">o llámanos al <a href={`tel:${tel}`}>{EMPRESA.telefonoVisible}</a></p>
    </div>
  </section>

  {destacados.length > 0 && (
    <section class="claves deco">
      <div class="contenedor">
        <ul class="claves__lista">
          {destacados.map(([k, t, v]) => <li><Icono nombre={k} tam={36} /><span class="claves__t">{t}</span><span class="claves__v">{v}</span></li>)}
        </ul>
      </div>
    </section>
  )}

  {m.precio != null && (
    <section class="seccion">
      <div class="contenedor">
        <span class="antetitulo">Financiación</span>
        <h2>Elige la cuota que mejor se adapte a ti</h2>
        <p class="intro">Decide si das entrada y en cuántos meses quieres pagar tu {nombre}.</p>
        <Financiacion precio={m.precio} moto={nombre} />
      </div>
    </section>
  )}

  {fotos.length > 0 && <GaleriaFotos fotos={fotos} nombre={nombre} />}


  {filas.length > 0 && (
    <section class="seccion seccion--gris">
      <div class="contenedor">
        <h2>Ficha técnica de la {nombre}</h2>
        <table class="tabla">
          <tbody>
            {filas.map(([k, t, v]) => <tr><th scope="row"><span class="tabla__th"><Icono nombre={k} tam={22} />{t}</span></th><td>{v}</td></tr>)}
          </tbody>
        </table>
        <p class="fuente">Datos del fabricante.{m.fuenteFicha && <> Fuente: <a href={m.fuenteFicha} rel="noopener nofollow" target="_blank">{new URL(m.fuenteFicha).hostname.replace('www.', '')}</a>.</>} Pueden variar según la versión o el año del modelo.</p>
      </div>
    </section>
  )}


  <div class="barra" data-barra>
    <div class="barra__in contenedor">
      <div class="barra__moto">
        {miniatura && <Image src={miniatura} format="avif" fit="contain" alt="" width={96} height={60} class="barra__img" />}
        <div><p class="barra__nombre">{nombre}</p><p class="barra__precio">{precioTexto(m)}</p></div>
      </div>
      <div class="barra__btns">
        {cuotaDesde && <a class="btn barra__fin" href="#financiacion" data-cuota-minima><span class="barra__fin-t">Calcula tu cuota</span><span class="barra__fin-c">desde {cuotaTxt} €/mes*</span></a>}
        <a class:list={["btn", { "btn--borde": !!cuotaDesde }]} href="#contacto">Me interesa</a>
        <a class="btn btn--borde barra__wa" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#25d366" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/><path fill="#fff" d="M17.3 14.4c-.3-.1-1.7-.8-1.9-.9-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1a7.6 7.6 0 0 1-3.8-3.3c-.3-.5.3-.5.8-1.6.1-.2 0-.4 0-.5l-.9-2c-.2-.5-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.3 3.3 0 0 0-1 2.5 5.8 5.8 0 0 0 1.2 3.1 13.3 13.3 0 0 0 5.1 4.5c1.9.8 2.6.9 3.6.7.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"/></svg><span>WhatsApp</span></a>
        <a class="btn btn--borde barra__llamar" href={`tel:${tel}`} aria-label="Llámanos">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          <span>Llámanos</span>
        </a>
      </div>
    </div>
  </div>

  <Formulario moto={nombre} titulo={`Pide información sobre la ${nombre}`} />

  {relacionadas.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <h2>También te puede interesar</h2>
        <div class="rejilla rejilla--motos">
          {relacionadas.map((r) => <TarjetaMoto moto={r} />)}
        </div>
      </div>
    </section>
  )}

</Base>

<script>
  // Al pulsar «Elige tu cuota desde…» la calculadora se abre con esa misma cuota (plazo máximo, sin entrada)
  const cuotaMinima = () => {
    const radios = [...document.querySelectorAll<HTMLInputElement>('#financiacion input[name="plazo"]')];
    const max = radios.sort((a, b) => Number(b.value) - Number(a.value))[0];
    const entrada = document.querySelector<HTMLInputElement>('#financiacion input[type="range"]');
    if (entrada) { entrada.value = '0'; entrada.dispatchEvent(new Event('input', { bubbles: true })); }
    if (max) { max.checked = true; max.dispatchEvent(new Event('input', { bubbles: true })); }
  };
  document.querySelectorAll('[data-cuota-minima]').forEach((a) => a.addEventListener('click', cuotaMinima));
  if (location.hash === '#financiacion') {
    const ir = () => setTimeout(cuotaMinima, 50);
    document.readyState === 'complete' ? ir() : addEventListener('load', ir, { once: true });
  }
  // Barra fija: en móvil siempre; en escritorio cuando los botones de arriba dejan de verse
  {
    const barra = document.querySelector<HTMLElement>('[data-barra]');
    const ctas = document.querySelector('[data-ctas]');
    const form = document.getElementById('contacto');
    if (barra) {
      const movil = matchMedia('(max-width: 900px)');
      let ctasVisibles = true, formVisible = false, calcVisible = false;
      const calc = document.getElementById('financiacion');
      const pintar = () => {
        const ver = (movil.matches || !ctasVisibles) && !formVisible && !calcVisible;
        barra.classList.toggle('visible', ver);
        document.documentElement.style.setProperty('--barra-alto', ver ? `${barra.offsetHeight}px` : '0px');
      };
      if (ctas) new IntersectionObserver(([e]) => { ctasVisibles = e.isIntersecting; pintar(); }).observe(ctas);
      if (form) new IntersectionObserver(([e]) => { formVisible = e.isIntersecting; pintar(); }, { threshold: 0.15 }).observe(form);
      if (calc) new IntersectionObserver(([e]) => { calcVisible = e.isIntersecting; pintar(); }, { threshold: 0.35 }).observe(calc);
      movil.addEventListener('change', pintar); addEventListener('resize', pintar, { passive: true });
      pintar();
    }
  }

  {
    const caja = document.querySelector<HTMLElement>('[data-carrusel]');
    const slides = [...document.querySelectorAll<HTMLImageElement>('.galeria__slide')];
    const total = slides.length + 1;
    const nEl = document.querySelector('[data-car-n]');
    const tiras = [...document.querySelectorAll<HTMLButtonElement>('[data-ir-slide]')];
    let actual = 0;
    const cargar = (k: number) => { const im = slides[k - 1]; if (im && !im.src) { im.srcset = im.dataset.srcset!; im.src = im.dataset.src!; } };
    const ir = (k: number) => {
      actual = (k + total) % total;
      caja?.classList.toggle('en-foto', actual > 0);
      slides.forEach((im, j) => im.classList.toggle('activa', j + 1 === actual));
      cargar(actual); cargar((actual + 1) % total);
      if (nEl) nEl.textContent = String(actual + 1);
      tiras.forEach((t) => t.classList.toggle('activa', Number(t.dataset.irSlide) === actual));
      tiras.find((t) => Number(t.dataset.irSlide) === actual)?.scrollIntoView({ block: 'nearest', inline: 'center' });
    };
    document.querySelector('[data-car-ant]')?.addEventListener('click', () => ir(actual - 1));
    document.querySelector('[data-car-sig]')?.addEventListener('click', () => ir(actual + 1));
    tiras.forEach((t) => t.addEventListener('click', () => ir(Number(t.dataset.irSlide))));
    // Ampliar: abre el visor en la foto que se está viendo
    document.querySelector('[data-car-ampliar]')?.addEventListener('click', () => dispatchEvent(new CustomEvent('abrir-visor', { detail: Math.max(0, actual - 1) })));
    // Deslizar con el dedo
    let x0: number | null = null;
    caja?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    caja?.addEventListener('touchend', (e) => {
      if (x0 == null || slides.length === 0) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) ir(actual + (dx < 0 ? 1 : -1));
    });
    caja?.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') ir(actual + 1); if (e.key === 'ArrowLeft') ir(actual - 1); });
    if (slides.length) setTimeout(() => cargar(1), 1500);

    document.querySelectorAll<HTMLButtonElement>('.galeria__mini').forEach((b) => {
      b.addEventListener('click', () => {
        const i = b.dataset.i;
        document.querySelectorAll('.galeria__img').forEach((img) => img.classList.toggle('activa', (img as HTMLElement).dataset.i === i));
        const n = document.querySelector('.galeria__nombre'); if (n) n.textContent = b.dataset.color ?? '';
        document.querySelectorAll('.galeria__mini').forEach((x) => { x.classList.toggle('activa', x === b); x.setAttribute('aria-pressed', String(x === b)); });
        ir(0);
      });
    });
  }
</script>

<style>
  .ficha { display: grid; grid-template-columns: 1.3fr 1fr; gap: max(28px, 4vw); padding-block: max(16px, 2vw) var(--esp-seccion); align-items: start; }
  .galeria__principal { position: relative; aspect-ratio: 5 / 3; background: #fff; border: 1px solid var(--borde); border-radius: var(--radio); display: grid; place-items: center; overflow: hidden; padding: 3%; }
  .galeria__principal :global(.galeria__img) { position: absolute; inset: 3%; width: 94%; height: 94%; max-width: none; object-fit: contain; opacity: 0; transition: opacity 0.25s; }
  .galeria__principal :global(.galeria__img.activa) { opacity: 1; }
  .galeria__sin { color: var(--gris); }
  .galeria__slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.3s; background: #f3f2f7; }
  .galeria__slide.activa { opacity: 1; }
  .galeria__principal.en-foto :global(.galeria__img.activa) { opacity: 0; }
  .galeria__flecha { position: absolute; top: 50%; translate: 0 -50%; z-index: 3; width: 44px; height: 44px; display: grid; place-items: center; border: 0; background: rgb(255 255 255 / 0.9); color: var(--azul); cursor: pointer; box-shadow: 0 4px 14px rgb(11 1 62 / 0.15); transition: background 0.2s, color 0.2s; }
  .galeria__flecha:hover { background: var(--naranja); color: #fff; }
  .galeria__flecha--ant { left: 10px; }
  .galeria__flecha--sig { right: 10px; }
  .galeria__ampliar { position: absolute; right: 10px; bottom: 10px; z-index: 3; width: 42px; height: 42px; display: grid; place-items: center; border: 0; background: var(--azul); color: #fff; cursor: zoom-in; transition: background 0.2s; }
  .galeria__ampliar:hover { background: var(--naranja); }
