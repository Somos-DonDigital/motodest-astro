---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TarjetaMoto from '../../../components/TarjetaMoto.astro';
import Formulario from '../../../components/Formulario.astro';
import Financiacion from '../../../components/Financiacion.astro';
import Icono from '../../../components/Icono.astro';
import GaleriaFotos from '../../../components/GaleriaFotos.astro';
import { marcaPorSlug, categoriaDe, EMPRESA } from '../../../data/sitio';
import { imgMoto, imgGaleria } from '../../../lib/imagenes';
import { ETIQUETAS, precioTexto, nombreCompleto, descripcionMoto, urlMoto, tipoMoto, type Moto } from '../../../lib/formato';

export async function getStaticPaths() {
  const motos = await getCollection('motos');
  return motos.map((m) => ({ params: { marca: m.data.marca, categoria: m.data.categoria, modelo: m.data.slug }, props: { moto: m } }));
}
const { moto } = Astro.props as { moto: Moto };
const m = moto.data;
const marca = marcaPorSlug(m.marca);
const cat = categoriaDe(m.marca, m.categoria);
const nombre = nombreCompleto(m);
const descripcion = descripcionMoto(m);
const filas = ETIQUETAS.filter(([k]) => m.ficha[k]).map(([k, et]) => [k, et, m.ficha[k]]);
const CLAVE = ['motor', 'cilindrada', 'potencia', 'par', 'alturaAsiento', 'peso', 'deposito', 'autonomia', 'bateria', 'traccion'];
const destacados = CLAVE.filter((k) => m.ficha[k]).slice(0, 6).map((k) => [k, ETIQUETAS.find(([x]) => x === k)![1], m.ficha[k]]);
const relacionadas = (await getCollection('motos', (x) => x.data.marca === m.marca && x.data.categoria === m.categoria && x.data.slug !== m.slug))
  .sort((a, b) => Math.abs(a.data.orden - m.orden) - Math.abs(b.data.orden - m.orden)).slice(0, 4);
const tel = EMPRESA.telefono.replace(/\s/g, '');
const wa = `https://wa.me/${EMPRESA.whatsapp}?text=${encodeURIComponent(`Hola, me interesa la ${nombre}.`)}`;
const imgs = m.imagenes.map((i) => imgMoto(i.src));
const variantes = m.imagenes.map((i) => i.color);
const fotos = (m.galeria ?? []).map((r) => imgGaleria(r));
const imgsSchema = await Promise.all(imgs.map(async (i) => new URL((await getImage({ src: i, width: 1200, format: 'jpg' })).src, Astro.site).toString()));

const producto: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: nombre,
  brand: { '@type': 'Brand', name: marca.nombre },
  category: tipoMoto(m),
  description: descripcion,
  url: new URL(urlMoto(m), Astro.site).toString(),
  ...(imgsSchema.length ? { image: imgsSchema } : {}),
  ...(variantes.length > 1 ? { color: variantes.join(', ') } : {}),
  ...(m.precio != null
    ? { offers: { '@type': 'Offer', priceCurrency: 'EUR', price: m.precio, url: new URL(urlMoto(m), Astro.site).toString(), itemCondition: 'https://schema.org/NewCondition', seller: { '@id': `${Astro.site!.toString().replace(/\/$/, '')}/#negocio` } } }
    : {}),
};
---
<Base
  titulo={`${nombre}: precio y ficha técnica`}
  moto={nombre}
  descripcion={descripcion}
  imagen={imgs[0]}
  tipoOg="product"
  migas={[{ nombre: marca.nombre, url: `/${marca.slug}/` }, { nombre: cat.nombre, url: `/${marca.slug}/${cat.slug}/` }, { nombre: m.nombre, url: urlMoto(m) }]}
  schema={[producto]}
>
  <section class="ficha contenedor">
    <div class="galeria">
      <div class="galeria__principal">
        {imgs.length
          ? imgs.map((src, i) => (
              <Image format="avif" fit="contain" src={src} alt={`${nombre}${imgs.length > 1 ? ` en color ${m.imagenes[i].color.toLowerCase()}` : ''}`} widths={[480, 800, 1200]} sizes="(max-width: 900px) 92vw, 55vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} class:list={['galeria__img', { activa: i === 0 }]} data-i={i} />
            ))
          : <div class="galeria__sin">Foto próximamente</div>}
        {fotos.length > 0 && (
          <button type="button" class="galeria__verfotos" data-abrir-foto="0">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h3l2-3h6l2 3h3v13H4z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
            Ver {fotos.length} fotos
          </button>
        )}
      </div>
      {imgs.length > 1 && (
        <div class="galeria__colores">
          <p class="galeria__etq">Color: <strong class="galeria__nombre">{m.imagenes[0].color}</strong></p>
          <div class="galeria__minis" role="group" aria-label="Elegir color">
            {imgs.map((src, i) => (
              <button type="button" class:list={['galeria__mini', { activa: i === 0 }]} data-i={i} data-color={m.imagenes[i].color} aria-label={m.imagenes[i].color} aria-pressed={i === 0 ? 'true' : 'false'}>
                <Image format="avif" fit="contain" src={src} alt="" width={120} layout="fixed" />
                <span class="galeria__punto" style={`--c:${m.imagenes[i].hex}`}></span>
              </button>
            ))}
          </div>
        </div>
      )}
      {fotos.length > 0 && (
        <div class="galeria__fotos">
          <p class="galeria__etq">Fotos</p>
          <div class="galeria__tira">
            {fotos.slice(0, 5).map((f, i) => (
              <button type="button" class="galeria__foto" data-abrir-foto={i} aria-label={`Ver foto ${i + 1}`}>
                <Image src={f} format="avif" alt="" width={160} height={106} fit="cover" />
                {i === 4 && fotos.length > 5 && <span>+{fotos.length - 5}</span>}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="resumen">
      <a class="resumen__marca" href={`/${marca.slug}/${cat.slug}/`}>{marca.nombre} · {cat.nombre}</a>
      <h1>{nombre}</h1>
      <p class="resumen__precio">{precioTexto(m)}</p>
      {m.precio != null && <p class="resumen__nota">Precio con la moto matriculada, IVA incluido. Consulta promociones y financiación.</p>}
      <p class="resumen__desc">{descripcion}</p>
      <div class="resumen__ctas">
        {m.precio != null
          ? <a class="btn btn--grande" href="#financiacion"><Icono nombre="euro" tam={22} /> Financiación inmediata</a>
          : <a class="btn btn--grande" href="#contacto">Pedir información</a>}
        <div class="resumen__sec">
          {m.precio != null && <a class="btn btn--borde" href="#contacto">Pedir información</a>}
          <a class="btn btn--borde" href={wa} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
      <p class="resumen__tel">o llámanos al <a href={`tel:${tel}`}>{EMPRESA.telefonoVisible}</a></p>
    </div>
  </section>

  {destacados.length > 0 && (
    <section class="claves deco">
      <div class="contenedor">
        <ul class="claves__lista">
          {destacados.map(([k, t, v]) => <li><Icono nombre={k} tam={36} /><span class="claves__t">{t}</span><span class="claves__v">{v}</span></li>)}
        </ul>
      </div>
    </section>
  )}

  {fotos.length > 0 && <GaleriaFotos fotos={fotos} nombre={nombre} />}

  {m.precio != null && (
    <section class="seccion">
      <div class="contenedor">
        <span class="antetitulo">Financiación</span>
        <h2>Calcula tu cuota</h2>
        <p class="intro">Elige si das entrada y en cuántos meses quieres pagar tu {nombre}.</p>
        <Financiacion precio={m.precio} moto={nombre} />
      </div>
    </section>
  )}

  {filas.length > 0 && (
    <section class="seccion seccion--gris">
      <div class="contenedor">
        <h2>Ficha técnica de la {nombre}</h2>
        <table class="tabla">
          <tbody>
            {filas.map(([k, t, v]) => <tr><th scope="row"><span class="tabla__th"><Icono nombre={k} tam={22} />{t}</span></th><td>{v}</td></tr>)}
          </tbody>
        </table>
        <p class="fuente">Datos del fabricante.{m.fuenteFicha && <> Fuente: <a href={m.fuenteFicha} rel="noopener nofollow" target="_blank">{new URL(m.fuenteFicha).hostname.replace('www.', '')}</a>.</>} Pueden variar según la versión o el año del modelo.</p>
      </div>
    </section>
  )}

  {relacionadas.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <h2>También te puede interesar</h2>
        <div class="rejilla rejilla--motos">
          {relacionadas.map((r) => <TarjetaMoto moto={r} />)}
        </div>
      </div>
    </section>
  )}

  <Formulario moto={nombre} titulo={`Pide información sobre la ${nombre}`} />
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.galeria__mini').forEach((b) => {
    b.addEventListener('click', () => {
      const i = b.dataset.i;
      document.querySelectorAll('.galeria__img').forEach((img) => img.classList.toggle('activa', (img as HTMLElement).dataset.i === i));
      const n = document.querySelector('.galeria__nombre'); if (n) n.textContent = b.dataset.color ?? '';
      document.querySelectorAll('.galeria__mini').forEach((x) => {
        x.classList.toggle('activa', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
    });
  });
</script>

<style>
  .ficha { display: grid; grid-template-columns: 1.3fr 1fr; gap: max(28px, 4vw); padding-block: max(16px, 2vw) var(--esp-seccion); align-items: start; }
  .galeria__principal { position: relative; aspect-ratio: 5 / 3; background: #fff; border: 1px solid var(--borde); border-radius: var(--radio); display: grid; place-items: center; overflow: hidden; padding: 3%; }
  .galeria__principal :global(.galeria__img) { position: absolute; inset: 3%; width: 94%; height: 94%; max-width: none; object-fit: contain; opacity: 0; transition: opacity 0.25s; }
  .galeria__principal :global(.galeria__img.activa) { opacity: 1; }
  .galeria__sin { color: var(--gris); }
  .resumen__inmediata { display: flex; align-items: center; gap: 8px; color: #1f8a3a; font-weight: 700; margin: 4px 0 14px; }
  .resumen__inmediata span { width: 10px; height: 10px; border-radius: 50%; background: #2fb34f; box-shadow: 0 0 0 0 rgb(47 179 79 / 0.6); animation: latido 1.8s infinite; }
  @keyframes latido { 70% { box-shadow: 0 0 0 8px rgb(47 179 79 / 0); } 100% { box-shadow: 0 0 0 0 rgb(47 179 79 / 0); } }
  @media (prefers-reduced-motion: reduce) { .resumen__inmediata span { animation: none; } }
  .resumen__ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: 18px; }
  .resumen__ctas :global(.btn--grande) { display: inline-flex; align-items: center; gap: 10px; font-size: 1.05rem; padding: 18px 30px; }
  .resumen__sec { display: flex; flex-wrap: wrap; gap: 10px; }
  .galeria__verfotos { position: absolute; left: 12px; bottom: 12px; z-index: 2; display: inline-flex; align-items: center; gap: 8px; background: var(--azul); color: #fff; border: 0; padding: 10px 14px; font: inherit; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; transition: background 0.2s; }
  .galeria__verfotos:hover { background: var(--naranja); }
  .galeria__fotos { margin-top: 18px; }
  .galeria__tira { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .galeria__foto { position: relative; padding: 0; border: 2px solid transparent; background: #eee; cursor: zoom-in; aspect-ratio: 3 / 2; overflow: hidden; transition: border-color 0.2s; }
  .galeria__foto:hover { border-color: var(--naranja); }
  .galeria__foto :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
  .galeria__foto:hover :global(img) { transform: scale(1.08); }
  .galeria__foto span { position: absolute; inset: 0; display: grid; place-items: center; background: rgb(11 1 62 / 0.6); color: #fff; font-weight: 800; font-size: 1.2rem; }
  .galeria__colores { margin-top: 14px; }
  .galeria__etq { margin-bottom: 8px; font-size: var(--fs-peq); }
  .galeria__minis { display: flex; flex-wrap: wrap; gap: 10px; }
  .galeria__mini { position: relative; }
  .galeria__punto { position: absolute; right: -6px; top: -6px; width: 20px; height: 20px; border-radius: 50%; background: var(--c); border: 2px solid #fff; box-shadow: 0 0 0 1px var(--borde); }
  .galeria__mini { border: 2px solid var(--borde); border-radius: 8px; background: #fff; padding: 4px; cursor: pointer; }
  .galeria__mini.activa { border-color: var(--naranja); }
  .galeria__mini :global(img) { width: 96px; height: 58px; object-fit: contain; }
  .resumen { position: sticky; top: calc(max(68px, 5.6vw) + 20px); }
  .resumen__marca { color: var(--naranja); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--fs-peq); text-decoration: none; }
  .resumen h1 { font-size: clamp(1.8rem, 3.2vw, 3.2rem); margin-top: 8px; }
  .resumen__precio { font-size: clamp(1.6rem, 2.4vw, 2.4rem); font-weight: 800; color: var(--azul); margin-bottom: 4px; }
  .resumen__nota { color: var(--gris); font-size: var(--fs-peq); }
  .resumen__desc { color: var(--gris); }
  .resumen__tel { margin-top: 12px; font-weight: 700; }
  .resumen__tel a { color: var(--naranja); text-decoration: none; }
  .resumen__fin { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; color: var(--azul); font-weight: 700; text-decoration: none; border-bottom: 2px solid var(--naranja); }
  .resumen__fin :global(.icono) { color: var(--naranja); }
  .claves { background: var(--azul); color: #fff; padding-block: max(24px, 2.4vw); }
  .claves__lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: max(16px, 2vw); }
  .claves__lista li { display: grid; gap: 4px; justify-items: start; }
  .claves__lista :global(.icono) { color: var(--naranja); margin-bottom: 4px; }
  .claves__t { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.8rem; color: #cfcce3; font-weight: 700; }
  .claves__v { font-weight: 700; line-height: 1.3; }
  .tabla__th { display: inline-flex; align-items: center; gap: 10px; }
  .tabla__th :global(.icono) { color: var(--naranja); flex: none; }
  .tabla { width: 100%; border-collapse: collapse; background: #fff; border-radius: var(--radio); overflow: hidden; }
  .tabla th, .tabla td { text-align: left; padding: 14px 20px; border-bottom: 1px solid var(--borde); vertical-align: top; }
  .tabla th { width: 32%; font-weight: 700; color: var(--azul); }
  .tabla tr:last-child th, .tabla tr:last-child td { border-bottom: 0; }
  .fuente { color: var(--gris); font-size: var(--fs-peq); margin-top: 16px; }
  @media (max-width: 900px) {
    .ficha { grid-template-columns: 1fr; }
    .resumen { position: static; }
    .tabla th, .tabla td { display: block; width: 100%; padding: 10px 16px; }
    .tabla th { border-bottom: 0; padding-bottom: 0; }
  }
</style>
