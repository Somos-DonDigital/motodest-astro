---
import '@fontsource-variable/cairo';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import Asistente from '../components/Asistente.astro';
import { EMPRESA } from '../data/sitio';
import { imgSitio } from '../lib/imagenes';
import type { ImageMetadata } from 'astro';

interface Miga { nombre: string; url: string }
interface Props {
  titulo: string;
  descripcion: string;
  imagen?: ImageMetadata;
  migas?: Miga[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  tipoOg?: 'website' | 'product';
  superpuesta?: boolean;
  moto?: string;
}

const { titulo, descripcion, imagen, migas = [], schema = [], noindex = false, tipoOg = 'website', superpuesta = false, moto = '' } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const tituloCompleto = titulo.includes('Motodest') ? titulo : `${titulo} | Motodest`;
const og = await getImage({ src: imagen ?? imgSitio('hero-675nk'), width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).toString();

const negocio = {
  '@context': 'https://schema.org',
  '@type': 'MotorcycleDealer',
  '@id': `${site}/#negocio`,
  name: 'Motodest',
  description: 'Concesionario oficial Fantic, Beta, CFMOTO y MITT en Barbate (Cádiz). Venta de motos nuevas, quads y buggies, financiación, taller y boutique.',
  url: `${site}/`,
  telephone: EMPRESA.telefono,
  email: EMPRESA.email,
  image: ogUrl,
  logo: `${site}/logo-motodest.png`,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: EMPRESA.direccion.calle,
    postalCode: EMPRESA.direccion.cp,
    addressLocality: EMPRESA.direccion.localidad,
    addressRegion: EMPRESA.direccion.provincia,
    addressCountry: EMPRESA.direccion.pais,
  },
  openingHoursSpecification: EMPRESA.horarioSchema.map((h) => ({ '@type': 'OpeningHoursSpecification', ...h })),
  areaServed: [{ '@type': 'Country', name: 'España' }, 'Barbate', 'Vejer de la Frontera', 'Conil de la Frontera', 'Zahara de los Atunes', 'Cádiz'],
  brand: ['Fantic', 'Beta', 'CFMOTO', 'MITT'].map((name) => ({ '@type': 'Brand', name })),
  ...(EMPRESA.redes.length ? { sameAs: EMPRESA.redes.map((r) => r.url) } : {}),
};

const migasSchema = migas.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ nombre: 'Inicio', url: '/' }, ...migas].map((m, i) => ({
        '@type': 'ListItem', position: i + 1, name: m.nombre, item: new URL(m.url, Astro.site).toString(),
      })),
    }]
  : [];
const todosSchemas = [negocio, ...migasSchema, ...schema];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#0b013e" />
    <link rel="preload" href="/fonts/death-star.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={tipoOg === 'product' ? 'product' : 'website'} />
    <meta property="og:site_name" content="Motodest" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {todosSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera superpuesta={superpuesta} />
    <main id="contenido">
      <slot name="hero" />
      {migas.length > 0 && (
        <nav class="migas contenedor" aria-label="Migas de pan">
          <ol>
            <li><a href="/">Inicio</a></li>
            {migas.map((m, i) => (
              <li>{i === migas.length - 1 ? <span aria-current="page">{m.nombre}</span> : <a href={m.url}>{m.nombre}</a>}</li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <Pie />
    <Asistente moto={moto} />
    <script>import '../scripts/esqueleto.ts';</script>
    <script>import '../scripts/animaciones.ts';</script>
  </body>
</html>
