---
// Barra negra bajo el carrusel (diseño). Solo compromisos reales de Motodest.
const items = [
  { t: 'Concesionario oficial', s: 'Fantic · Beta · CFMOTO · MITT', url: '/#destacadas', d: '<path d="M12 3 5 6v5c0 5 3 8.5 7 10 4-1.5 7-5 7-10V6z"/><path d="m9 12 2 2 4-4"/>' },
  { t: 'Paga a tu ritmo', s: 'Financiación a medida', url: '/#financiacion', d: '<rect x="3" y="6" width="18" height="12" rx="1"/><path d="M3 10h18M7 15h4"/>' },
  { t: 'Motos de alquiler', s: 'Consulta fechas', url: '/#servicios', d: '<circle cx="6" cy="16" r="3"/><circle cx="18" cy="16" r="3"/><path d="M6 16 9 9h5l4 7M9 9H7M14 9l2-3h2"/>' },
  { t: 'Segunda mano', s: 'Motos revisadas', url: '/#servicios', d: '<path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v4h-4"/>' },
  { t: 'Tienda boutique', s: 'Cascos y equipación', url: '/#servicios', d: '<path d="M5 8h14l-1 12H6z"/><path d="M9 8a3 3 0 0 1 6 0"/>' },
];
---
<ul class="ventajas">
  {items.map((i) => (
    <li><a href={i.url}>
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={i.d} />
      <span><strong>{i.t}</strong><small>{i.s}</small></span>
    </a></li>
  ))}
</ul>
<style>
  .ventajas { list-style: none; margin: 0; padding: max(14px, 1.2vw) 4vw; background: #000; color: #fff; display: flex; justify-content: space-between; gap: 18px; overflow-x: auto; }
  .ventajas a { display: flex; align-items: center; gap: 10px; text-decoration: none; white-space: nowrap; }
  .ventajas svg { color: var(--naranja); flex: none; }
  .ventajas span { display: grid; line-height: 1.2; }
  .ventajas strong { text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.04em; }
  .ventajas small { text-transform: uppercase; font-size: 0.68rem; color: #bbb; letter-spacing: 0.04em; }
  .ventajas a:hover strong { color: var(--naranja); }
</style>
