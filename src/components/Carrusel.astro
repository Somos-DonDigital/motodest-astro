---
// Carrusel de cabecera a pantalla completa (diseño): foto, título del modelo y "Descubre más".
import { Image } from 'astro:assets';
import { imgSitio } from '../lib/imagenes';
export interface Diapo { img: string; titulo: string; url: string; texto?: string; alt?: string; pos?: string }
interface Props { diapos: Diapo[]; h1?: string; alto?: 'alto' | 'medio' }
const { diapos, h1, alto = 'alto' } = Astro.props;
const varias = diapos.length > 1;
---
<section class:list={['carr', `carr--${alto}`]} data-carr aria-roledescription={varias ? 'carrusel' : undefined} aria-label="Destacados">
  <div class="carr__pista" data-pista>
    {diapos.map((d, i) => (
      <div class="carr__diapo" role={varias ? 'group' : undefined} aria-roledescription={varias ? 'diapositiva' : undefined} aria-label={varias ? `${i + 1} de ${diapos.length}` : undefined}>
        <Image format="avif" src={imgSitio(d.img)} alt={d.alt ?? d.titulo} widths={[640, 960, 1440, 2000]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} class="carr__img" style={d.pos ? `object-position:${d.pos}` : undefined} />
        <div class="carr__capa contenedor">
          {i === 0 && h1 ? <h1 class="carr__tit">{d.titulo}<span class="sr-only"> · {h1}</span></h1> : <p class="carr__tit">{d.titulo}</p>}
          {d.texto && <p class="carr__txt">{d.texto}</p>}
          <a class="btn carr__btn" href={d.url}>Descubre más</a>
        </div>
      </div>
    ))}
  </div>
  {varias && (
    <>
      <button class="carr__flecha carr__flecha--ant" type="button" aria-label="Anterior" data-ant><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
      <button class="carr__flecha carr__flecha--sig" type="button" aria-label="Siguiente" data-sig><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
      <div class="carr__puntos" role="group" aria-label="Elegir diapositiva">
        {diapos.map((_, i) => <button type="button" class:list={['carr__punto', { activo: i === 0 }]} aria-label={`Ir a la ${i + 1}`} data-ir={i}></button>)}
      </div>
    </>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carr]').forEach((c) => {
    const pista = c.querySelector<HTMLElement>('[data-pista]')!;
    const n = pista.children.length;
    if (n < 2) return;
    const puntos = [...c.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    let i = 0;
    const ir = (k: number) => { i = (k + n) % n; pista.scrollTo({ left: i * pista.clientWidth, behavior: 'smooth' }); };
    pista.addEventListener('scroll', () => {
      const k = Math.round(pista.scrollLeft / pista.clientWidth);
      if (k !== i) i = k;
      puntos.forEach((p, j) => p.classList.toggle('activo', j === k));
    }, { passive: true });
    c.querySelector('[data-ant]')!.addEventListener('click', () => { ir(i - 1); parar(); });
    c.querySelector('[data-sig]')!.addEventListener('click', () => { ir(i + 1); parar(); });
    puntos.forEach((p, j) => p.addEventListener('click', () => { ir(j); parar(); }));
    const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let t = reducir ? 0 : window.setInterval(() => { if (!document.hidden) ir(i + 1); }, 6000);
    function parar() { if (t) { clearInterval(t); t = 0; } }
    c.addEventListener('pointerdown', parar);
    c.addEventListener('focusin', parar);
  });
</script>

<style>
  .carr { position: relative; background: #000; color: #fff; }
  .carr__pista { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .carr__pista::-webkit-scrollbar { display: none; }
  .carr__diapo { position: relative; scroll-snap-align: start; display: grid; align-items: end; min-height: clamp(520px, 62vw, 900px); overflow: hidden; }
  .carr--medio .carr__diapo { min-height: clamp(460px, 54vw, 780px); }
  .carr__diapo :global(.carr__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .carr__diapo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 0.6) 0%, rgb(0 0 0 / 0) 45%); }
  .carr__capa { position: relative; z-index: 1; padding-bottom: max(64px, 6vw); }
  .carr__tit { font-family: var(--fuente-texto); font-weight: 700; text-transform: uppercase; font-size: clamp(1.7rem, 2.8vw, 2.8rem); line-height: 1.05; letter-spacing: 0; max-width: 16ch; margin: 0 0 12px; }
  .carr__txt { max-width: 48ch; margin: 0 0 14px; }
  .carr__btn { padding: 6px 28px; }
  .carr__flecha { position: absolute; top: 50%; transform: translateY(-50%); background: none; border: 0; color: #fff; padding: 12px; cursor: pointer; z-index: 2; opacity: 0.85; }
  .carr__flecha:hover { opacity: 1; color: var(--naranja); }
  .carr__flecha--ant { left: max(8px, 3vw); }
  .carr__flecha--sig { right: max(8px, 3vw); }
  .carr__puntos { position: absolute; left: 50%; bottom: max(20px, 2vw); transform: translateX(-50%); display: flex; gap: 10px; z-index: 2; }
  .carr__punto { width: 11px; height: 11px; border-radius: 50%; border: 0; padding: 0; background: #fff; cursor: pointer; }
  .carr__punto.activo { background: var(--naranja); }
  @media (max-width: 700px) { .carr__flecha { display: none; } .carr__diapo { min-height: 78vh; } }
</style>
