---
import { MARCAS, EMPRESA } from '../data/sitio';
interface Props { superpuesta?: boolean }
const { superpuesta = false } = Astro.props;
const ruta = Astro.url.pathname;
const tel = EMPRESA.telefono.replace(/\s/g, '');
const enlaces = [
  { url: '/#financiacion', nombre: 'Financiación' },
  { url: '/#servicios', nombre: 'Servicios' },
  { url: '/contacto/', nombre: 'Contacto' },
];
---
<header class:list={['cab', { 'cab--sobre': superpuesta }]} data-cab>
  <div class="cab__barra contenedor">
    <a href="/" class="cab__logo" aria-label="Motodest, ir al inicio">
      <img src="/logo-motodest.svg" alt="Motodest" width="190" height="28" />
    </a>
    <nav class="cab__enlaces" aria-label="Enlaces">
      {enlaces.map((e) => <a href={e.url} class:list={{ activo: ruta === e.url }}>{e.nombre}</a>)}
    </nav>
    <a class="cab__tel" href={`tel:${tel}`} aria-label={`Llamar al ${EMPRESA.telefonoVisible}`}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
      <span>{EMPRESA.telefonoVisible}</span>
    </a>
    <button class="cab__toggle" aria-expanded="false" aria-controls="cab-menu">
      <span class="sr-only">Abrir menú</span>
      <span class="cab__hamb" aria-hidden="true"></span>
    </button>
  </div>

  <div class="cab__menu" id="cab-menu">
    <div class="contenedor cab__menu-in">
      <form class="buscador" role="search" action="/" data-buscador>
        <label class="sr-only" for="buscar-modelo">Encuentra tu modelo</label>
        <input id="buscar-modelo" type="search" placeholder="Encuentra tu modelo…" autocomplete="off" aria-autocomplete="list" aria-controls="buscar-res" aria-expanded="false" />
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="m21 21-4.3-4.3M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"/></svg>
        <ul id="buscar-res" class="buscador__res" role="listbox" hidden></ul>
      </form>
      <nav class="pestanas" aria-label="Marcas">
        <ul>
          {MARCAS.map((m) => (
            <li class="pestana">
              <a href={`/${m.slug}/`} class:list={['pestana__btn', { activo: ruta.startsWith(`/${m.slug}/`) }]}>{m.nombre}</a>
              <ul class="pestana__sub">
                {m.categorias.map((c) => <li><a href={`/${m.slug}/${c.slug}/`} class:list={{ activo: ruta.startsWith(`/${m.slug}/${c.slug}/`) }}>{c.nombre}</a></li>)}
              </ul>
            </li>
          ))}
        </ul>
      </nav>
      <nav class="cab__enlaces cab__enlaces--movil" aria-label="Enlaces">
        {enlaces.map((e) => <a href={e.url}>{e.nombre}</a>)}
        <a class="btn" href={`tel:${tel}`}>Llámanos al {EMPRESA.telefonoVisible}</a>
      </nav>
    </div>
  </div>
</header>

<script>
  const cab = document.querySelector<HTMLElement>('[data-cab]')!;
  const btn = cab.querySelector<HTMLButtonElement>('.cab__toggle')!;
  btn.addEventListener('click', () => {
    const abierto = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!abierto));
    document.body.classList.toggle('menu-abierto', !abierto);
  });
  cab.querySelectorAll('a[href^="/#"]').forEach((a) => a.addEventListener('click', () => {
    btn.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-abierto');
  }));
  const fijar = () => cab.classList.toggle('cab--solida', window.scrollY > 40);
  fijar();
  window.addEventListener('scroll', fijar, { passive: true });

  // Buscador de modelos: índice estático (/buscar.json) que se carga al primer foco
  type Item = { n: string; m: string; u: string; c: string };
  const form = cab.querySelector<HTMLFormElement>('[data-buscador]')!;
  const input = form.querySelector('input')!;
  const lista = form.querySelector<HTMLUListElement>('.buscador__res')!;
  let indice: Item[] | null = null;
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  const cargar = async () => { if (!indice) indice = await fetch('/buscar.json').then((r) => r.json()).catch(() => []); };
  const pintar = () => {
    const q = norm(input.value);
    if (!q || !indice) { lista.hidden = true; input.setAttribute('aria-expanded', 'false'); return; }
    const partes = q.split(' ');
    const res = indice.filter((i) => { const t = norm(`${i.m} ${i.n} ${i.c}`); return partes.every((p) => t.includes(p)); }).slice(0, 8);
    lista.innerHTML = '';
    if (!res.length) {
      const li = document.createElement('li'); li.className = 'buscador__vacio'; li.textContent = 'No encontramos ese modelo. Llámanos y te ayudamos.'; lista.append(li);
    }
    res.forEach((i) => {
      const li = document.createElement('li'); li.setAttribute('role', 'option');
      const a = document.createElement('a'); a.href = i.u;
      const s = document.createElement('small'); s.textContent = `${i.m} · ${i.c}`;
      a.append(document.createTextNode(i.n), s); li.append(a); lista.append(li);
    });
    lista.hidden = false; input.setAttribute('aria-expanded', 'true');
  };
  input.addEventListener('focus', async () => { await cargar(); pintar(); });
  input.addEventListener('input', async () => { await cargar(); pintar(); });
  form.addEventListener('submit', (e) => { e.preventDefault(); const a = lista.querySelector('a'); if (a) location.href = a.href; });
  document.addEventListener('click', (e) => { if (!form.contains(e.target as Node)) { lista.hidden = true; input.setAttribute('aria-expanded', 'false'); } });
</script>

<style>
  .cab { position: sticky; top: 0; z-index: 50; background: var(--azul); color: #fff; transition: background 0.25s; }
  .cab--sobre { position: fixed; inset: 0 0 auto; background: linear-gradient(180deg, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0)); }
  .cab--sobre.cab--solida, .cab--sobre:has(.cab__toggle[aria-expanded='true']) { background: var(--azul); }
  .cab__barra { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: max(18px, 2vw); min-height: max(64px, 4.6vw); }
  .cab__logo img { width: clamp(140px, 12vw, 180px); height: auto; }
  .cab__enlaces { display: flex; justify-content: center; gap: max(18px, 3vw); }
  .cab__enlaces a { text-decoration: none; text-transform: uppercase; font-size: var(--fs-peq); letter-spacing: 0.08em; }
  .cab__enlaces a:hover, .cab__enlaces a.activo { color: var(--naranja); }
  .cab__tel { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 700; }
  .cab__tel:hover { color: var(--naranja); }

  .cab__menu-in { display: grid; justify-items: center; gap: 10px; padding-bottom: 14px; }
  .cab--solida .cab__menu-in { padding-bottom: 10px; }
  .cab--solida .buscador { display: none; }
  .buscador { position: relative; width: min(100%, 420px); }
  .buscador input { width: 100%; font: inherit; font-size: var(--fs-peq); color: #fff; background: rgb(255 255 255 / 0.08); border: 1px solid rgb(255 255 255 / 0.85); border-radius: 999px; padding: 6px 40px 6px 16px; }
  .buscador input::placeholder { color: rgb(255 255 255 / 0.85); }
  .buscador input:focus { outline: none; background: rgb(11 1 62 / 0.85); border-color: var(--naranja); }
  .buscador > svg { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; }
  .buscador__res { position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 5; list-style: none; margin: 0; padding: 6px 0; background: #fff; color: var(--texto); box-shadow: 0 18px 40px rgb(0 0 0 / 0.25); max-height: 60vh; overflow: auto; }
  .buscador__res :global(a) { display: grid; padding: 8px 16px; text-decoration: none; font-weight: 700; }
  .buscador__res :global(a:hover), .buscador__res :global(a:focus) { background: var(--gris-claro); color: var(--naranja); }
  .buscador__res :global(small) { font-weight: 400; color: var(--gris); text-transform: capitalize; }
  .buscador__res :global(.buscador__vacio) { padding: 8px 16px; font-size: var(--fs-peq); color: var(--gris); }

  .pestanas ul { list-style: none; margin: 0; padding: 0; }
  .pestanas > ul { display: flex; gap: max(8px, 1vw); }
  .pestana { position: relative; }
  .pestana__btn { display: block; min-width: clamp(110px, 9vw, 150px); padding: 3px 14px; text-align: center; text-decoration: none; text-transform: uppercase; font-weight: 700; font-size: var(--fs-peq); letter-spacing: 0.06em; border: 1px solid #fff; transition: background 0.2s, border-color 0.2s; }
  .pestana__btn:hover, .pestana__btn.activo, .pestana:focus-within .pestana__btn { background: var(--naranja); border-color: var(--naranja); }
  .pestana__sub { position: absolute; left: 0; right: 0; top: 100%; background: rgb(11 1 62 / 0.96); border: 1px solid #fff; border-top: 0; opacity: 0; visibility: hidden; transition: opacity 0.15s; }
  .pestana:hover .pestana__sub, .pestana:focus-within .pestana__sub { opacity: 1; visibility: visible; }
  .pestana__sub a { display: block; padding: 4px 10px; text-align: center; text-decoration: none; font-size: var(--fs-peq); border-top: 1px solid rgb(255 255 255 / 0.25); }
  .pestana__sub a:hover, .pestana__sub a.activo { color: var(--naranja); }
  .cab__enlaces--movil { display: none; }

  .cab__toggle { display: none; background: none; border: 0; color: #fff; padding: 12px; cursor: pointer; }
  .cab__hamb, .cab__hamb::before, .cab__hamb::after { display: block; width: 26px; height: 2px; background: currentColor; position: relative; transition: 0.2s; }
  .cab__hamb::before, .cab__hamb::after { content: ''; position: absolute; left: 0; }
  .cab__hamb::before { top: -8px; } .cab__hamb::after { top: 8px; }
  [aria-expanded='true'] .cab__hamb { background: transparent; }
  [aria-expanded='true'] .cab__hamb::before { top: 0; transform: rotate(45deg); }
  [aria-expanded='true'] .cab__hamb::after { top: 0; transform: rotate(-45deg); }

  @media (max-width: 1024px) {
    .cab__barra { grid-template-columns: 1fr auto auto; }
    .cab__barra > .cab__enlaces { display: none; }
    .cab__tel span { display: none; }
    .cab__toggle { display: block; }
    .cab__menu { position: fixed; inset: max(64px, 4.6vw) 0 0; background: var(--azul); overflow-y: auto; transform: translateX(100%); transition: transform 0.25s; }
    :global(.menu-abierto) .cab__menu { transform: none; }
    :global(.menu-abierto) { overflow: hidden; }
    .cab__menu-in { justify-items: stretch; gap: 22px; padding-block: 18px 40px; }
    .cab--solida .buscador { display: block; }
    .buscador { width: 100%; }
    .pestanas > ul { flex-direction: column; gap: 14px; }
    .pestana__btn { text-align: left; font-size: 1.05rem; padding: 10px 14px; }
    .pestana__sub { position: static; opacity: 1; visibility: visible; display: flex; flex-wrap: wrap; border: 0; background: none; padding: 6px 0 0; }
    .pestana__sub a { border: 0; padding: 6px 14px 6px 14px; text-align: left; color: #cfcce3; }
    .cab__enlaces--movil { display: grid; gap: 14px; justify-content: stretch; }
    .cab__enlaces--movil a { font-size: 1rem; }
  }
</style>
