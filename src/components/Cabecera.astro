---
import { MARCAS, EMPRESA } from '../data/sitio';
interface Props { superpuesta?: boolean }
const { superpuesta = false } = Astro.props;
const ruta = Astro.url.pathname;
const tel = EMPRESA.telefono.replace(/\s/g, '');
const enlaces = [
  { url: '/#financiacion', nombre: 'Financiación' },
  { url: '/#servicios', nombre: 'Servicios' },
  { url: '/contacto/', nombre: 'Contacto' },
];
---
<header class:list={['cab', { 'cab--sobre': superpuesta }]} data-cab>
  <div class="cab__barra contenedor">
    <a href="/" class="cab__logo" aria-label="Motodest, ir al inicio">
      <img src="/logo-motodest.svg" alt="Motodest" width="190" height="28" />
    </a>

    <div class="cab__menu" id="cab-menu">
      <nav class="pestanas" aria-label="Marcas">
        <ul>
          {MARCAS.map((m) => (
            <li class="pestana">
              <a href={`/${m.slug}/`} class:list={['pestana__btn', { activo: ruta.startsWith(`/${m.slug}/`) }]}>{m.nombre}</a>
              <ul class="pestana__sub">
                {m.categorias.map((c) => <li><a href={`/${m.slug}/${c.slug}/`} class:list={{ activo: ruta.startsWith(`/${m.slug}/${c.slug}/`) }}>{c.nombre}</a></li>)}
              </ul>
            </li>
          ))}
        </ul>
      </nav>
      <nav class="cab__enlaces" aria-label="Enlaces">
        {enlaces.map((e) => <a href={e.url} class:list={{ activo: ruta === e.url }}>{e.nombre}</a>)}
      </nav>
      <a class="btn cab__llamar" href={`tel:${tel}`}>Llámanos al {EMPRESA.telefonoVisible}</a>
    </div>

    <div class="cab__acciones">
      <button class="cab__icono" type="button" aria-label="Buscar modelo" aria-expanded="false" aria-controls="cab-buscar" data-abrir-buscar>
        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="m21 21-4.3-4.3M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"/></svg>
      </button>
      <a class="cab__tel" href={`tel:${tel}`} aria-label={`Llamar al ${EMPRESA.telefonoVisible}`}>
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
        <span>{EMPRESA.telefonoVisible}</span>
      </a>
      <button class="cab__toggle" aria-expanded="false" aria-controls="cab-menu">
        <span class="sr-only">Abrir menú</span>
        <span class="cab__hamb" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="buscar" id="cab-buscar" hidden>
    <form class="buscar__in contenedor" role="search" data-buscador>
      <label class="sr-only" for="buscar-modelo">Encuentra tu modelo</label>
      <input id="buscar-modelo" type="search" placeholder="Encuentra tu modelo: 800MT, Caballero, XEF…" autocomplete="off" aria-controls="buscar-res" />
      <ul id="buscar-res" class="buscar__res" role="listbox"></ul>
    </form>
  </div>
</header>

<script>
  const cab = document.querySelector<HTMLElement>('[data-cab]')!;
  const btn = cab.querySelector<HTMLButtonElement>('.cab__toggle')!;
  const cerrarMenu = () => { btn.setAttribute('aria-expanded', 'false'); document.body.classList.remove('menu-abierto'); };
  btn.addEventListener('click', () => {
    const abierto = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!abierto));
    document.body.classList.toggle('menu-abierto', !abierto);
    cerrarBuscar();
  });
  cab.querySelectorAll('.cab__menu a[href^="/#"]').forEach((a) => a.addEventListener('click', cerrarMenu));
  const fijar = () => cab.classList.toggle('cab--solida', window.scrollY > 40);
  fijar();
  window.addEventListener('scroll', fijar, { passive: true });

  // Buscador: panel bajo la cabecera con miniatura, marca, gama y precio
  type Item = { n: string; m: string; u: string; c: string; p: string; i: string };
  const panel = cab.querySelector<HTMLElement>('#cab-buscar')!;
  const abrirBtn = cab.querySelector<HTMLButtonElement>('[data-abrir-buscar]')!;
  const form = panel.querySelector<HTMLFormElement>('[data-buscador]')!;
  const input = form.querySelector('input')!;
  const lista = form.querySelector<HTMLUListElement>('.buscar__res')!;
  let indice: Item[] | null = null;
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  const cargar = async () => { if (!indice) indice = await fetch('/buscar.json').then((r) => r.json()).catch(() => []); };
  function cerrarBuscar() { panel.hidden = true; abrirBtn.setAttribute('aria-expanded', 'false'); cab.classList.remove('cab--buscando'); }
  abrirBtn.addEventListener('click', async () => {
    if (!panel.hidden) return cerrarBuscar();
    cerrarMenu();
    panel.hidden = false; abrirBtn.setAttribute('aria-expanded', 'true'); cab.classList.add('cab--buscando');
    input.focus(); await cargar(); pintar();
  });
  const pintar = () => {
    lista.innerHTML = '';
    const q = norm(input.value);
    if (!q || !indice) return;
    const partes = q.split(' ');
    const res = indice.filter((i) => { const t = norm(`${i.m} ${i.n} ${i.c}`); return partes.every((p) => t.includes(p)); }).slice(0, 8);
    if (!res.length) {
      const li = document.createElement('li'); li.className = 'buscar__vacio'; li.textContent = 'No encontramos ese modelo. Llámanos y te ayudamos.'; lista.append(li); return;
    }
    res.forEach((i) => {
      const li = document.createElement('li'); li.setAttribute('role', 'option');
      const a = document.createElement('a'); a.href = i.u;
      if (i.i) { const img = document.createElement('img'); img.src = i.i; img.alt = ''; img.width = 96; img.height = 60; img.loading = 'lazy'; a.append(img); }
      const t = document.createElement('span'); t.className = 'buscar__txt';
      const s = document.createElement('small'); s.textContent = `${i.m} · ${i.c}`;
      const n = document.createElement('strong'); n.textContent = i.n;
      t.append(s, n); a.append(t);
      const p = document.createElement('span'); p.className = 'buscar__precio'; p.textContent = i.p; a.append(p);
      li.append(a); lista.append(li);
    });
  };
  input.addEventListener('input', async () => { await cargar(); pintar(); });
  form.addEventListener('submit', (e) => { e.preventDefault(); const a = lista.querySelector('a'); if (a) location.href = a.href; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarBuscar(); });
  document.addEventListener('click', (e) => { if (!panel.hidden && !cab.contains(e.target as Node)) cerrarBuscar(); });
</script>

<style>
  .cab { position: sticky; top: 0; z-index: 50; background: var(--azul); color: #fff; transition: background 0.25s; }
  .cab--sobre { position: fixed; inset: 0 0 auto; background: linear-gradient(180deg, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0)); }
  .cab--sobre.cab--solida, .cab--sobre.cab--buscando, .cab--sobre:has(.cab__toggle[aria-expanded='true']) { background: var(--azul); }
  .cab__barra { display: flex; align-items: center; gap: max(16px, 1.8vw); min-height: max(68px, 5vw); }
  .cab__logo img { width: clamp(140px, 11vw, 175px); height: auto; }
  .cab__menu { flex: 1; display: flex; align-items: center; justify-content: center; gap: max(18px, 2.4vw); }
  .cab__enlaces { display: flex; gap: max(14px, 1.6vw); }
  .cab__enlaces a { text-decoration: none; text-transform: uppercase; font-size: var(--fs-peq); letter-spacing: 0.08em; white-space: nowrap; }
  .cab__enlaces a:hover, .cab__enlaces a.activo { color: var(--naranja); }
  .cab__llamar { display: none; }
  .cab__acciones { display: flex; align-items: center; gap: max(10px, 1vw); }
  .cab__icono { background: none; border: 0; color: #fff; padding: 8px; cursor: pointer; display: grid; place-items: center; }
  .cab__icono:hover, .cab__icono[aria-expanded='true'] { color: var(--naranja); }
  .cab__tel { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 700; white-space: nowrap; }
  .cab__tel:hover { color: var(--naranja); }

  .pestanas ul { list-style: none; margin: 0; padding: 0; }
  .pestanas > ul { display: flex; gap: max(6px, 0.6vw); }
  .pestana { position: relative; }
  .pestana__btn { display: block; min-width: clamp(84px, 7.4vw, 124px); padding: 4px 12px; text-align: center; text-decoration: none; text-transform: uppercase; font-weight: 700; font-size: var(--fs-peq); letter-spacing: 0.06em; border: 1px solid #fff; transition: background 0.2s, border-color 0.2s; }
  .pestana__btn:hover, .pestana__btn.activo, .pestana:focus-within .pestana__btn { background: var(--naranja); border-color: var(--naranja); }
  .pestana__sub { position: absolute; left: 0; right: 0; top: 100%; background: rgb(11 1 62 / 0.97); border: 1px solid #fff; border-top: 0; opacity: 0; visibility: hidden; transition: opacity 0.15s; }
  .pestana:hover .pestana__sub, .pestana:focus-within .pestana__sub { opacity: 1; visibility: visible; }
  .pestana__sub a { display: block; padding: 5px 10px; text-align: center; text-decoration: none; font-size: var(--fs-peq); border-top: 1px solid rgb(255 255 255 / 0.25); white-space: nowrap; }
  .pestana__sub a:hover, .pestana__sub a.activo { color: var(--naranja); }

  .buscar { background: var(--azul); border-top: 1px solid rgb(255 255 255 / 0.12); box-shadow: 0 20px 40px rgb(0 0 0 / 0.3); }
  .buscar__in { padding-block: 14px 18px; max-width: 760px; }
  .buscar input { width: 100%; font: inherit; font-size: 1.05rem; color: #fff; background: transparent; border: 0; border-bottom: 2px solid var(--naranja); padding: 8px 2px; }
  .buscar input::placeholder { color: rgb(255 255 255 / 0.6); }
  .buscar input:focus { outline: none; }
  .buscar__res { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 4px; max-height: 64vh; overflow: auto; }
  .buscar__res :global(a) { display: grid; grid-template-columns: 96px 1fr auto; align-items: center; gap: 16px; padding: 6px 10px; text-decoration: none; background: #fff; color: var(--texto); }
  .buscar__res :global(a:hover), .buscar__res :global(a:focus) { outline: 2px solid var(--naranja); }
  .buscar__res :global(img) { width: 96px; height: 60px; object-fit: contain; }
  .buscar__res :global(.buscar__txt) { display: grid; line-height: 1.25; }
  .buscar__res :global(small) { color: var(--gris); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .buscar__res :global(strong) { font-size: 1.05rem; color: var(--azul); }
  .buscar__res :global(.buscar__precio) { font-weight: 800; color: var(--naranja); white-space: nowrap; }
  .buscar__res :global(.buscar__vacio) { padding: 8px 2px; color: #cfcce3; }

  .cab__toggle { display: none; background: none; border: 0; color: #fff; padding: 12px; cursor: pointer; }
  .cab__hamb, .cab__hamb::before, .cab__hamb::after { display: block; width: 26px; height: 2px; background: currentColor; position: relative; transition: 0.2s; }
  .cab__hamb::before, .cab__hamb::after { content: ''; position: absolute; left: 0; }
  .cab__hamb::before { top: -8px; } .cab__hamb::after { top: 8px; }
  [aria-expanded='true'] .cab__hamb { background: transparent; }
  [aria-expanded='true'] .cab__hamb::before { top: 0; transform: rotate(45deg); }
  [aria-expanded='true'] .cab__hamb::after { top: 0; transform: rotate(-45deg); }

  @media (max-width: 1180px) {
    .cab__tel span { display: none; }
  }
  @media (max-width: 1024px) {
    .cab__barra { justify-content: space-between; }
    .cab__toggle { display: block; }
    .cab__menu { position: fixed; inset: max(68px, 5vw) 0 0; background: var(--azul); overflow-y: auto; transform: translateX(100%); transition: transform 0.25s; flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 24px; padding: 20px 4vw 40px; }
    :global(.menu-abierto) .cab__menu { transform: none; }
    :global(.menu-abierto) { overflow: hidden; }
    .pestanas > ul { flex-direction: column; gap: 14px; }
    .pestana__btn { text-align: left; font-size: 1.05rem; padding: 10px 14px; }
    .pestana__sub { position: static; opacity: 1; visibility: visible; display: flex; flex-wrap: wrap; border: 0; background: none; padding: 6px 0 0; }
    .pestana__sub a { border: 0; padding: 6px 14px; text-align: left; color: #cfcce3; }
    .cab__enlaces { flex-direction: column; gap: 14px; }
    .cab__enlaces a { font-size: 1rem; }
    .cab__llamar { display: inline-flex; }
    .buscar__res :global(a) { grid-template-columns: 72px 1fr; }
    .buscar__res :global(img) { width: 72px; height: 46px; }
    .buscar__res :global(.buscar__precio) { grid-column: 2; }
  }
</style>
