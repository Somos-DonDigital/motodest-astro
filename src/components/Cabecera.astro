---
import { MARCAS, EMPRESA } from '../data/sitio';
const ruta = Astro.url.pathname;
---
<header class="cab">
  <div class="cab__barra contenedor">
    <a href="/" class="cab__logo" aria-label="Motodest, ir al inicio">
      <img src="/logo-motodest.svg" alt="Motodest" width="190" height="28" />
    </a>
    <button class="cab__toggle" aria-expanded="false" aria-controls="menu-principal">
      <span class="sr-only">Abrir menú</span>
      <span class="cab__hamb" aria-hidden="true"></span>
    </button>
    <nav id="menu-principal" class="cab__nav" aria-label="Menú principal">
      <ul class="cab__lista">
        {MARCAS.map((m) => (
          <li class="cab__item">
            <a href={`/${m.slug}/`} class:list={['cab__enlace', { activo: ruta.startsWith(`/${m.slug}/`) }]}>{m.nombre}</a>
            <ul class="cab__sub">
              {m.categorias.map((c) => <li><a href={`/${m.slug}/${c.slug}/`}>{c.nombre}</a></li>)}
            </ul>
          </li>
        ))}
        <li class="cab__item"><a href="/contacto/" class:list={['cab__enlace', { activo: ruta.startsWith('/contacto/') }]}>Contacto</a></li>
      </ul>
      <a class="btn cab__tel" href={`tel:${EMPRESA.telefono.replace(/\s/g, '')}`}>Llámanos</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.cab__toggle');
  btn?.addEventListener('click', () => {
    const abierto = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!abierto));
    document.body.classList.toggle('menu-abierto', !abierto);
  });
</script>

<style>
  .cab { position: sticky; top: 0; z-index: 50; background: var(--azul); color: #fff; }
  .cab__barra { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: max(68px, 5.6vw); }
  .cab__logo :global(img) { width: clamp(140px, 13vw, 190px); height: auto; }
  .cab__nav { display: flex; align-items: center; gap: max(18px, 2vw); }
  .cab__lista { display: flex; gap: max(6px, 1vw); list-style: none; margin: 0; padding: 0; }
  .cab__item { position: relative; }
  .cab__enlace { display: block; padding: 10px 12px; text-decoration: none; font-family: var(--fuente-titulos); font-size: clamp(0.85rem, 1vw, 1rem); letter-spacing: 0.06em; text-transform: uppercase; }
  .cab__enlace:hover, .cab__enlace.activo { color: var(--naranja); }
  .cab__sub { position: absolute; left: 0; top: 100%; min-width: 220px; background: #fff; color: var(--texto); list-style: none; margin: 0; padding: 8px 0; border-radius: var(--radio); box-shadow: 0 16px 40px rgb(11 1 62 / 0.18); opacity: 0; visibility: hidden; transform: translateY(6px); transition: 0.18s; }
  .cab__item:hover .cab__sub, .cab__item:focus-within .cab__sub { opacity: 1; visibility: visible; transform: none; }
  .cab__sub a { display: block; padding: 8px 18px; text-decoration: none; font-weight: 600; }
  .cab__sub a:hover { background: var(--gris-claro); color: var(--naranja); }
  .cab__tel { padding: 10px 22px; }
  .cab__toggle { display: none; background: none; border: 0; color: #fff; padding: 12px; cursor: pointer; }
  .cab__hamb, .cab__hamb::before, .cab__hamb::after { display: block; width: 26px; height: 2px; background: currentColor; position: relative; transition: 0.2s; }
  .cab__hamb::before, .cab__hamb::after { content: ''; position: absolute; left: 0; }
  .cab__hamb::before { top: -8px; } .cab__hamb::after { top: 8px; }
  [aria-expanded='true'] .cab__hamb { background: transparent; }
  [aria-expanded='true'] .cab__hamb::before { top: 0; transform: rotate(45deg); }
  [aria-expanded='true'] .cab__hamb::after { top: 0; transform: rotate(-45deg); }

  @media (max-width: 1024px) {
    .cab__toggle { display: block; }
    .cab__nav { position: fixed; inset: max(68px, 5.6vw) 0 0 0; background: var(--azul); flex-direction: column; align-items: stretch; padding: 16px 4vw 32px; overflow-y: auto; transform: translateX(100%); transition: transform 0.25s; }
    :global(.menu-abierto) .cab__nav { transform: none; }
    :global(.menu-abierto) { overflow: hidden; }
    .cab__lista { flex-direction: column; gap: 0; }
    .cab__enlace { font-size: 1.15rem; padding: 14px 0; border-bottom: 1px solid rgb(255 255 255 / 0.12); }
    .cab__sub { position: static; opacity: 1; visibility: visible; transform: none; background: transparent; color: #cfcce3; box-shadow: none; padding: 4px 0 10px 12px; display: flex; flex-wrap: wrap; gap: 4px 0; }
    .cab__sub a { padding: 6px 14px 6px 0; font-weight: 500; }
    .cab__sub a:hover { background: none; }
    .cab__tel { margin-top: 20px; }
  }
</style>
