---
import { EMPRESA } from '../data/sitio';
interface Props { moto?: string; titulo?: string; subtitulo?: string; id?: string }
const { moto = '', titulo = '¿Necesitas que te asesoremos?', subtitulo = 'Déjanos tus datos y te llamamos', id = 'contacto' } = Astro.props;
const tel = EMPRESA.telefono.replace(/\s/g, '');
---
<section class="form-sec seccion seccion--azul deco" id={id}>
  <div class="contenedor form-sec__in">
    <div class="form-sec__txt">
      <span class="antetitulo">Contacto</span>
      <h2 class="form-sec__tit">{titulo}</h2>
      <p class="form-sec__sub">{subtitulo}</p>
      <p class="intro">Déjanos tus datos y te llamamos para resolver tus dudas, preparar una prueba o un presupuesto con financiación.</p>
      <a class="form-sec__tel" href={`tel:${tel}`}>{EMPRESA.telefonoVisible}</a>
      <p class="form-sec__hor">{EMPRESA.horario.map((h) => <>{h.dias}: {h.horas}<br /></>)}</p>
    </div>
    <form class="form" method="post" action="/api/contacto.php" data-form-contacto>
      <input type="hidden" name="moto" value={moto} />
      <input type="hidden" name="origen" value={Astro.url.pathname} />
      <div class="form__trampa" aria-hidden="true"><label>No rellenar <input type="text" name="web" tabindex="-1" autocomplete="off" /></label></div>
      <label>Nombre<input type="text" name="nombre" required autocomplete="name" maxlength="80" /></label>
      <label>Teléfono<input type="tel" name="telefono" required autocomplete="tel" maxlength="20" pattern="[0-9 +()-]{9,20}" /></label>
      <label class="form__ancho">Email<input type="email" name="email" required autocomplete="email" maxlength="120" /></label>
      {moto
        ? <p class="form__moto form__ancho">Consulta sobre: <strong>{moto}</strong></p>
        : <label class="form__ancho">¿Qué moto te interesa?<input type="text" name="moto_libre" maxlength="120" /></label>}
      <label class="form__ancho">Información adicional<textarea name="mensaje" rows="3" maxlength="2000"></textarea></label>
      <label class="form__check form__ancho">
        <input type="checkbox" name="privacidad" value="1" required />
        <span>He leído y acepto la <a href="/politica-de-privacidad/" target="_blank">política de privacidad</a>.</span>
      </label>
      <label class="form__check form__ancho">
        <input type="checkbox" name="comercial" value="1" />
        <span>Quiero recibir ofertas y novedades de Motodest.</span>
      </label>
      <div class="form__envio form__ancho">
        <button class="btn" type="submit">Enviar consulta</button>
        <span>o llámanos al <a href={`tel:${tel}`}>{EMPRESA.telefonoVisible}</a></span>
      </div>
      <p class="form__info form__ancho">Responsable: Motodest. Finalidad: responder a tu consulta. Más información en la política de privacidad.</p>
    </form>
  </div>
</section>
<script>
  import Swal from 'sweetalert2';
  import 'sweetalert2/dist/sweetalert2.min.css';
  const aviso = Swal.mixin({
    buttonsStyling: false,
    customClass: { popup: 'md-swal', title: 'md-swal__tit', htmlContainer: 'md-swal__txt', confirmButton: 'btn', icon: 'md-swal__icono' },
  });
  document.querySelectorAll<HTMLFormElement>('[data-form-contacto]').forEach((form) => {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!form.reportValidity()) return;
      const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const tel = form.closest('section')?.querySelector<HTMLAnchorElement>('.form-sec__tel');
      if (boton) { boton.disabled = true; boton.dataset.txt = boton.textContent || ''; boton.textContent = 'Enviando…'; }
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const d = await r.json().catch(() => ({ ok: false }));
        if (!r.ok || !d.ok) throw new Error(d.error || '');
        form.reset();
        await aviso.fire({
          icon: 'success',
          title: '¡Consulta enviada!',
          html: 'Gracias. Te llamamos lo antes posible.',
          confirmButtonText: 'Perfecto',
        });
      } catch (e) {
        await aviso.fire({
          icon: 'error',
          title: 'No se ha podido enviar',
          html: `Inténtalo de nuevo o llámanos al <a href="${tel?.href ?? 'tel:630553494'}">${tel?.textContent ?? '630 55 34 94'}</a>.`,
          confirmButtonText: 'Entendido',
        });
      } finally {
        if (boton) { boton.disabled = false; boton.textContent = boton.dataset.txt || 'Enviar consulta'; }
      }
    });
  });
</script>
<style is:global>
  .md-swal { border-radius: 0 !important; padding: 2.2em 1.6em 1.8em !important; font-family: inherit !important; border-top: 6px solid var(--naranja); }
  .md-swal__tit { font-family: 'Cairo', sans-serif !important; font-weight: 800 !important; color: var(--azul) !important; font-size: 1.7rem !important; }
  .md-swal__txt { color: #4a4668 !important; font-size: 1.05rem !important; }
  .md-swal__txt a { color: var(--naranja); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .md-swal .swal2-icon.swal2-success { border-color: var(--naranja) !important; color: var(--naranja) !important; }
  .md-swal .swal2-icon.swal2-success [class^='swal2-success-line'] { background-color: var(--naranja) !important; }
  .md-swal .swal2-icon.swal2-success .swal2-success-ring { border-color: rgb(244 123 41 / 0.3) !important; }
  .md-swal .swal2-actions { margin-top: 1.4em; }
  .swal2-container.swal2-backdrop-show { background: rgb(11 1 62 / 0.6) !important; }
</style>
<style>
  .form-sec.deco::before { display: none; }
  .form-sec__in { display: grid; grid-template-columns: 1fr 1.15fr; gap: max(36px, 5vw); align-items: start; }
  .form-sec__tit { color: #fff; font-size: clamp(1.8rem, 3.2vw, 3.2rem); margin-bottom: 6px; }
  .form-sec__sub { color: var(--naranja); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--fs-peq); }
  .form-sec__tel { display: inline-block; margin-top: 10px; font-size: clamp(1.6rem, 2.6vw, 2.4rem); font-weight: 800; color: var(--naranja); text-decoration: none; }
  .form-sec__tel:hover { color: #fff; }
  .form-sec__hor { color: #cfcce3; font-size: var(--fs-peq); margin-top: 12px; }
  .form { display: grid; grid-template-columns: 1fr 1fr; gap: 26px 28px; }
  .form__ancho { grid-column: 1 / -1; }
  .form label { display: grid; gap: 4px; color: #cfcce3; font-size: var(--fs-peq); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
  .form input[type='text'], .form input[type='tel'], .form input[type='email'], .form textarea { font: inherit; font-size: 1.05rem; text-transform: none; letter-spacing: 0; font-weight: 400; color: #fff; padding: 8px 0; border: 0; border-bottom: 1.5px solid rgb(255 255 255 / 0.4); background: transparent; width: 100%; border-radius: 0; resize: vertical; transition: border-color 0.25s; }
  .form input:focus, .form textarea:focus { outline: none; border-bottom-color: var(--naranja); }
  .form__check { grid-template-columns: auto 1fr !important; align-items: start; gap: 10px !important; text-transform: none !important; letter-spacing: 0 !important; font-weight: 400 !important; }
  .form__check input { margin-top: 5px; accent-color: var(--naranja); }
  .form__check a { color: var(--naranja); }
  .form__moto { margin: 0; font-size: var(--fs-peq); color: #cfcce3; }
  .form__moto strong { color: #fff; }
  .form__trampa { position: absolute; left: -9999px; }
  .form__envio { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; color: #cfcce3; }
  .form__envio a { color: var(--naranja); font-weight: 700; text-decoration: none; }
  .form__info { font-size: 0.78rem; color: #9a96b8; margin: 0; }
  @media (max-width: 860px) { .form-sec__in { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .form { grid-template-columns: 1fr; } }
</style>
